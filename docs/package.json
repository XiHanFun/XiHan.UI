{
  "name": "xihan-ui-docs",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "description": "XiHan.UI 文档站：框架无关的设计系统运行时，提供 Vue、React 与 Web Components 三端适配器。",
  "author": {
    "name": "XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://ui.docs.xihanfun.com",
  "repository": {
    "url": "https://github.com/XiHanFun/XiHan.UI"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.UI/issues"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "dev": "vitepress dev",
    "build": "vitepress build",
    "serve": "vitepress serve",
    "preview": "vitepress preview",
    "clean": "rimraf .vitepress/dist",
    "clean:modules": "rimraf node_modules",
    "upgrade": "pnpm upgrade",
    "reinstall": "pnpm run clean:modules && pnpm install --frozen-lockfile",
    "rebuild": "pnpm run clean && pnpm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@xihan-ui/animations": "link:../ui/packages/features/animations",
    "@xihan-ui/code-highlight": "link:../ui/packages/features/code-highlight",
    "@xihan-ui/core": "link:../ui/packages/engine/core",
    "@xihan-ui/headless": "link:../ui/packages/engine/headless",
    "@xihan-ui/icons": "link:../ui/packages/design/icons",
    "@xihan-ui/markdown": "link:../ui/packages/features/markdown",
    "@xihan-ui/motion": "link:../ui/packages/engine/motion",
    "@xihan-ui/react": "link:../ui/packages/adapters/react",
    "@xihan-ui/sound": "link:../ui/packages/features/sound",
    "@xihan-ui/styles": "link:../ui/packages/design/styles",
    "@xihan-ui/vue": "link:../ui/packages/adapters/vue",
    "@xihan-ui/web-components": "link:../ui/packages/adapters/web-components",
    "vitepress": "^1.6.4",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@xihan-ui/eslint-config": "link:../ui/tooling/eslint-config",
    "eslint": "10.7.0"
  }
}
