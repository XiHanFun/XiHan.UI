{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "tsconfig.lib.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tokens/**", "build/**", "tsdown.config.ts", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "spec/**", "runners/**", "*.vue", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tests/**",
        "spec/**",
        "runners/**",
        "vitest*.config.ts",
        "package.json"
      ],
      "outputs": ["coverage/**"]
    },
    "@xihan-ui/styles#build": {
      "inputs": [
        "index.css",
        "css/**",
        "build/**",
        "package.json",
        "$TURBO_ROOT$/scripts/component-docs.manifest.json",
        "$TURBO_ROOT$/tooling/scripts/lib/component-token-manifest.mjs",
        "$TURBO_ROOT$/packages/design/tokens/tokens.json"
      ],
      "outputs": ["component-tokens.d.ts", "component-tokens.js", "components.tokens.json", "index.unlayered.css"]
    },
    "@xihan-ui/tokens#test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "tokens/**", "tokens.css", "vitest*.config.ts", "package.json"],
      "outputs": ["coverage/**"]
    },
    "@xihan-ui/testing#test": {
      "dependsOn": ["^build", "@xihan-ui/vue#build", "@xihan-ui/react#build", "@xihan-ui/web-components#build"],
      "inputs": ["src/**", "tests/**", "spec/**", "runners/**", "vitest*.config.ts", "package.json"],
      "outputs": ["coverage/**"]
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "vitest.browser.config.ts", "package.json"],
      "outputs": []
    }
  }
}
