{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "tsconfig.lib.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tokens/**", "build/**", "tsdown.config.ts", "package.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "*.vue", "tsconfig*.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "spec/**", "runners/**"],
      "outputs": ["coverage/**"]
    },
    "@xihan-ui/styles#build": {
      "inputs": ["index.css", "styles/**", "build/**", "package.json"],
      "outputs": []
    },
    "@xihan-ui/testing#test": {
      "dependsOn": ["^build", "@xihan-ui/vue#build", "@xihan-ui/web-components#build"],
      "inputs": ["src/**", "tests/**", "spec/**", "runners/**"],
      "outputs": ["coverage/**"]
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "vitest.browser.config.ts", "package.json"],
      "outputs": []
    }
  }
}
