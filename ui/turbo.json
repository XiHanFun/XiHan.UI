{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", "tsconfig.lib.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tokens/**", "build/**", "tsdown.config.ts", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "*.vue", "tsconfig*.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tests/**",
        "spec/**",
        "runners/**",
        "vitest*.config.ts",
        "package.json"
      ],
      "outputs": ["coverage/**"]
    },
    "@xihan-ui/styles#build": {
      "inputs": ["index.css", "css/**", "build/**", "package.json"],
      "outputs": []
    },
    "@xihan-ui/tokens#test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "tokens/**", "tokens.css", "vitest*.config.ts", "package.json"],
      "outputs": ["coverage/**"]
    },
    "@xihan-ui/testing#test": {
      "dependsOn": ["^build", "@xihan-ui/vue#build", "@xihan-ui/web-components#build"],
      "inputs": ["src/**", "tests/**", "spec/**", "runners/**", "vitest*.config.ts", "package.json"],
      "outputs": ["coverage/**"]
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "vitest.browser.config.ts", "package.json"],
      "outputs": []
    }
  }
}
