{
  "name": "@xihan-ui/vue",
  "type": "module",
  "version": "0.0.0",
  "description": "XiHan.UI Vue adapter — components, composables, machine runtime.",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "dependencies": {
    "@xihan-ui/behavior": "workspace:*",
    "@xihan-ui/core": "workspace:*",
    "@xihan-ui/headless": "workspace:*",
    "@xihan-ui/machine": "workspace:*",
    "@xihan-ui/position": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vue/test-utils": "catalog:",
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/styled": "workspace:*",
    "@xihan-ui/system": "workspace:*",
    "@xihan-ui/testing": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
