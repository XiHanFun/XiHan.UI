{
  "name": "@xihan-ui/wc",
  "type": "module",
  "version": "0.0.0",
  "description": "XiHan.UI Web Components adapter — Light-DOM behavior hosts on ReactiveElement.",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "files": ["custom-elements.json", "dist"],
  "scripts": {
    "build": "tsdown",
    "cem": "cem analyze",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@lit/reactive-element": "catalog:",
    "@xihan-ui/behavior": "workspace:*",
    "@xihan-ui/core": "workspace:*",
    "@xihan-ui/headless": "workspace:*",
    "@xihan-ui/machine": "workspace:*",
    "@xihan-ui/position-floating-ui": "workspace:*"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "catalog:",
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/testing": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "jsdom": "catalog:",
    "vitest": "catalog:"
  }
}
