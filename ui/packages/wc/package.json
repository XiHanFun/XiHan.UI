{
  "name": "@xihan-ui/wc",
  "type": "module",
  "version": "0.0.0",
  "description": "XiHan.UI Web Components adapter — Light-DOM behavior hosts on XhReactiveElement.",
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./visual": {
      "types": "./dist/visual.d.ts",
      "import": "./dist/visual.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "files": [
    "custom-elements.json",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "cem": "cem analyze",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@xihan-ui/behavior": "workspace:*",
    "@xihan-ui/core": "workspace:*",
    "@xihan-ui/headless": "workspace:*",
    "@xihan-ui/highlight": "workspace:*",
    "@xihan-ui/machine": "workspace:*",
    "@xihan-ui/position": "workspace:*"
  },
  "peerDependencies": {
    "@xihan-ui/visual": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@xihan-ui/visual": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "catalog:",
    "@lit/reactive-element": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/styled": "workspace:*",
    "@xihan-ui/system": "workspace:*",
    "@xihan-ui/testing": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "@xihan-ui/visual": "workspace:*",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "vitest": "catalog:"
  }
}
