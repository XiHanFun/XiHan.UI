{
  "name": "@xihan-ui/web-components",
  "type": "module",
  "version": "1.0.0-alpha.3",
  "description": "XiHan.UI Web Components adapter — Light-DOM behavior hosts on XhReactiveElement.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://ui.docs.xihanfun.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.UI.git",
    "directory": "ui/packages/adapters/web-components"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.UI/issues"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "headless-ui",
    "design-system"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backgrounds": {
      "types": "./dist/backgrounds.d.ts",
      "import": "./dist/backgrounds.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./custom-elements.json": "./custom-elements.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "custom-elements.json",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "customElements": "custom-elements.json",
  "scripts": {
    "build": "tsdown",
    "cem": "cem analyze && node scripts/enrich-cem.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:demos": "vitest run --config vitest.demos.config.ts --reporter verbose"
  },
  "peerDependencies": {
    "@xihan-ui/backgrounds": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@xihan-ui/backgrounds": {
      "optional": true
    }
  },
  "dependencies": {
    "@xihan-ui/behavior": "workspace:^",
    "@xihan-ui/code-highlight": "workspace:^",
    "@xihan-ui/headless": "workspace:^",
    "@xihan-ui/kernel": "workspace:^",
    "@xihan-ui/machine": "workspace:^",
    "@xihan-ui/motion": "workspace:^",
    "@xihan-ui/position": "workspace:^"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "catalog:",
    "@lit/reactive-element": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@xihan-ui/backgrounds": "workspace:*",
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/styles": "workspace:*",
    "@xihan-ui/testing": "workspace:*",
    "@xihan-ui/tokens": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "vitest": "catalog:"
  }
}
