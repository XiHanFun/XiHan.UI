{
  "name": "@xihan-ui/vue",
  "type": "module",
  "version": "1.0.0",
  "description": "XiHan.UI Vue adapter — components, composables, machine runtime.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://ui.docs.xihanfun.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.UI.git",
    "directory": "ui/packages/adapters/vue"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.UI/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "headless-ui",
    "design-system"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backgrounds": {
      "types": "./dist/backgrounds.d.ts",
      "import": "./dist/backgrounds.js"
    },
    "./behavior": {
      "types": "./dist/behavior.d.ts",
      "import": "./dist/behavior.js"
    },
    "./sound": {
      "types": "./dist/sound.d.ts",
      "import": "./dist/sound.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "peerDependencies": {
    "@xihan-ui/backgrounds": "workspace:^",
    "@xihan-ui/sound": "workspace:^",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@xihan-ui/backgrounds": {
      "optional": true
    },
    "@xihan-ui/sound": {
      "optional": true
    }
  },
  "dependencies": {
    "@xihan-ui/behavior": "workspace:^",
    "@xihan-ui/code-highlight": "workspace:^",
    "@xihan-ui/headless": "workspace:^",
    "@xihan-ui/kernel": "workspace:^",
    "@xihan-ui/machine": "workspace:^",
    "@xihan-ui/motion": "workspace:^",
    "@xihan-ui/position": "workspace:^"
  },
  "devDependencies": {
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vue/test-utils": "catalog:",
    "@xihan-ui/backgrounds": "workspace:*",
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/sound": "workspace:*",
    "@xihan-ui/styles": "workspace:*",
    "@xihan-ui/testing": "workspace:*",
    "@xihan-ui/tokens": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
