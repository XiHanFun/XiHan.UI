{
  "name": "@xihan-ui/tokens",
  "type": "module",
  "version": "1.1.0",
  "description": "XiHan.UI design tokens + theme runtime.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://ui.docs.xihanfun.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.UI.git",
    "directory": "ui/packages/design/tokens"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.UI/issues"
  },
  "keywords": [
    "design-tokens",
    "dtcg",
    "theming",
    "css-variables"
  ],
  "sideEffects": [
    "./tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist",
    "tokens.css",
    "tokens.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "gen": "node build/emit-tokens.mjs",
    "build": "node build/emit-tokens.mjs && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "jsdom": "catalog:",
    "vitest": "catalog:"
  }
}
