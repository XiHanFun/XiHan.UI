{
  "$description": "prefers-reduced-motion: reduce 档。只重映射动效语义令牌，不动 primitive——duration.* 与 space.* 还被非动效场景共用。几何类时长取 1ms 而非 0：动画名照常变化、animationend 照常派发，进出场时序不分叉。换色与出现的淡变不属于运动，保留为 fast 一档：duration-enter 收到 fast，duration-micro 与 duration-exit 本就是 fast，不覆盖。",
  "motion": {
    "duration-enter": {
      "$type": "duration",
      "$value": "{duration.fast}"
    },
    "duration-move": {
      "$type": "duration",
      "$value": "1ms"
    },
    "duration-expand": {
      "$type": "duration",
      "$value": "1ms"
    },
    "duration-collapse": {
      "$type": "duration",
      "$value": "1ms"
    },
    "duration-slide": {
      "$type": "duration",
      "$value": "1ms"
    },
    "duration-nudge": {
      "$type": "duration",
      "$value": "1ms"
    },
    "duration-press": {
      "$type": "duration",
      "$value": "1ms"
    },
    "duration-release": {
      "$type": "duration",
      "$value": "1ms"
    },
    "duration-attention": {
      "$type": "duration",
      "$value": "1ms"
    },
    "duration-glint": {
      "$type": "duration",
      "$value": "1ms"
    },
    "stagger-step": {
      "$type": "duration",
      "$value": "0ms"
    },
    "distance-sm": {
      "$type": "dimension",
      "$value": "0px"
    },
    "distance-md": {
      "$type": "dimension",
      "$value": "0px"
    },
    "distance-lg": {
      "$type": "dimension",
      "$value": "0px"
    },
    "travel": {
      "$type": "dimension",
      "$value": "0px"
    },
    "travel-opacity": {
      "$type": "number",
      "$value": 0
    },
    "scale-enter": {
      "$type": "number",
      "$value": 1
    },
    "scale-exit": {
      "$type": "number",
      "$value": 1
    },
    "scale-stack": {
      "$type": "number",
      "$value": 1
    },
    "scale-press": {
      "$type": "number",
      "$value": 1
    },
    "scale-breathe": {
      "$type": "number",
      "$value": 1
    },
    "scale-halo": {
      "$type": "number",
      "$value": 1
    },
    "scale-drag": {
      "$type": "number",
      "$value": 1
    },
    "scale-squash": {
      "$type": "number",
      "$value": 1
    }
  }
}
