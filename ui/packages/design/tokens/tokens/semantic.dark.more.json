{
  "$description": "深色 · 高对比档（data-contrast='more'）。判据同浅色档：每条边界对 bg.canvas 与 bg.surface 都不低于 4.5:1，且每条都要比常规档更重。深色下更浅即更高对比，所以取值往色阶的亮端走。",
  "border": {
    "default": { "$type": "color", "$value": "{color.neutral.400}" },
    "subtle": { "$type": "color", "$value": "{color.neutral.450}" },
    "strong": { "$type": "color", "$value": "{color.neutral.300}" },
    "control": { "$type": "color", "$value": "{color.neutral.400}" },
    "control-hover": { "$type": "color", "$value": "{color.neutral.300}" },
    "invalid": { "$type": "color", "$value": "{color.danger.400}" },
    "at-limit": { "$type": "color", "$value": "{color.warning.400}" }
  },
  "material": {
    "soft": {
      "$description": "深色高对比档独立重映射 M1 边界；高光归零，由明确边界承担轮廓。",
      "border": { "$type": "color", "$value": "{border.subtle}" },
      "highlight": { "$type": "color", "$value": "oklch(0 0 0 / 0)" },
      "separator": { "$type": "color", "$value": "{border.subtle}" }
    },
    "frosted": {
      "$description": "深色高对比档同样实体化，不让浅色高对比别名穿进深色作用域。",
      "compact": {
        "alpha": { "$type": "number", "$value": "{alpha.opaque}" },
        "backdrop": { "$type": "string", "$value": "none" },
        "shadow": { "$type": "shadow", "$value": "none" }
      },
      "bg": { "$type": "color", "$value": "{bg.surface}" },
      "backdrop": { "$type": "string", "$value": "none" },
      "border": { "$type": "color", "$value": "{border.subtle}" },
      "highlight": { "$type": "color", "$value": "oklch(0 0 0 / 0)" },
      "separator": { "$type": "color", "$value": "{border.subtle}" },
      "focus-surface": { "$type": "color", "$value": "{bg.surface}" }
    }
  }
}
