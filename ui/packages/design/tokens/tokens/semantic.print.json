{
  "$description": "打印档。纸上没有屏幕光源：投影与材质高光会变成脏灰或无意义亮边。海拔角色和材质绘制效果在打印时取消，只重映射语义角色，不动 shadow.* 原语。",
  "elevation": {
    "raised": {
      "$type": "shadow",
      "$value": "none"
    },
    "lifted": {
      "$type": "shadow",
      "$value": "none"
    },
    "floating": {
      "$type": "shadow",
      "$value": "none"
    },
    "sheet": {
      "$type": "shadow",
      "$value": "none"
    }
  },
  "material": {
    "elevated": {
      "$description": "打印时 M4 变为普通实体内容面，不输出滤镜、装饰高光或三层投影。",
      "bg": { "$type": "color", "$value": "{bg.surface}" },
      "backdrop": { "$type": "string", "$value": "none" },
      "border": { "$type": "color", "$value": "{border.default}" },
      "highlight": { "$type": "color", "$value": "oklch(0 0 0 / 0)" },
      "shadow": { "$type": "shadow", "$value": "none" },
      "separator": { "$type": "color", "$value": "{border.subtle}" }
    },
    "glass": {
      "bg": {
        "$type": "color",
        "$value": "{bg.surface}"
      },
      "backdrop": {
        "$type": "string",
        "$value": "none"
      },
      "border": {
        "$type": "color",
        "$value": "{border.subtle}"
      },
      "highlight": {
        "$type": "color",
        "$value": "oklch(0 0 0 / 0)"
      },
      "separator": {
        "$type": "color",
        "$value": "{border.subtle}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "none"
      }
    },
    "soft": {
      "$description": "纸面不保留装饰高光和接触影，结构只靠内容与分隔线。",
      "highlight": {
        "$type": "color",
        "$value": "oklch(0 0 0 / 0)"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "none"
      }
    },
    "frosted": {
      "$description": "打印时磨砂面变成普通实体内容面，不打印滤镜、高光或投影。",
      "compact": {
        "alpha": { "$type": "number", "$value": "{alpha.opaque}" },
        "backdrop": { "$type": "string", "$value": "none" },
        "shadow": { "$type": "shadow", "$value": "none" }
      },
      "bg": { "$type": "color", "$value": "{bg.surface}" },
      "backdrop": { "$type": "string", "$value": "none" },
      "border": { "$type": "color", "$value": "{border.default}" },
      "highlight": { "$type": "color", "$value": "oklch(0 0 0 / 0)" },
      "shadow": { "$type": "shadow", "$value": "none" },
      "separator": { "$type": "color", "$value": "{border.subtle}" }
    }
  }
}
