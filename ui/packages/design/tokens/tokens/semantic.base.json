{
  "control": {
    "h-sm": {
      "$type": "dimension",
      "$value": "32px"
    },
    "h-md": {
      "$type": "dimension",
      "$value": "36px"
    },
    "h-lg": {
      "$type": "dimension",
      "$value": "40px"
    },
    "box-sm": {
      "$type": "dimension",
      "$value": "32px"
    },
    "box-md": {
      "$type": "dimension",
      "$value": "40px"
    },
    "box-lg": {
      "$type": "dimension",
      "$value": "48px"
    },
    "w": {
      "$description": "单行字段根的缺省宽度：不传尺寸时下拉、日期、文本框等一律这么宽，宽度不再随内容走。",
      "$type": "dimension",
      "$value": "16rem"
    },
    "min-w": {
      "$description": "字段被 flex / grid 容器压缩时的底线：低于它就无法使用，容器再窄也不让步。",
      "$type": "dimension",
      "$value": "12rem"
    },
    "px-sm": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "px-md": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "px-lg": {
      "$type": "dimension",
      "$value": "{space.4}"
    },
    "gap-sm": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "gap-md": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "gap-lg": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "font-sm": {
      "$type": "dimension",
      "$value": "{font-size.sm}"
    },
    "font-md": {
      "$type": "dimension",
      "$value": "{font-size.md}"
    },
    "font-lg": {
      "$type": "dimension",
      "$value": "{font-size.lg}"
    },
    "separator-opacity": {
      "$description": "分组控件内分隔线的默认透明度。",
      "$type": "number",
      "$value": 0.16
    },
    "separator-disabled-opacity": {
      "$description": "分组控件禁用时分隔线的透明度。",
      "$type": "number",
      "$value": 0.36
    },
    "caption-sm": {
      "$description": "控件里的次级文字（提示、计数、快捷键、清空钮、标签项）：比同档主文字低一级。",
      "$type": "dimension",
      "$value": "{font-size.xs}"
    },
    "caption-md": {
      "$type": "dimension",
      "$value": "{font-size.sm}"
    },
    "caption-lg": {
      "$type": "dimension",
      "$value": "{font-size.md}"
    },
    "action-size": {
      "$type": "dimension",
      "$value": "24px"
    },
    "indicator-size": {
      "$description": "中档的别名，给不分档的指示符（多数控件的勾选格、指示点只有一档）。",
      "$type": "dimension",
      "$value": "{control.indicator-md}"
    },
    "indicator-sm": {
      "$type": "dimension",
      "$value": "12px"
    },
    "indicator-md": {
      "$type": "dimension",
      "$value": "16px"
    },
    "indicator-lg": {
      "$type": "dimension",
      "$value": "20px"
    }
  },
  "scrollbar": {
    "thickness-sm": {
      "$type": "dimension",
      "$value": "4px"
    },
    "thickness-md": {
      "$type": "dimension",
      "$value": "6px"
    },
    "thickness-lg": {
      "$type": "dimension",
      "$value": "8px"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "1px"
    }
  },
  "glyph": {
    "size-text": {
      "$type": "dimension",
      "$value": "1em"
    },
    "size-sm": {
      "$type": "dimension",
      "$value": "16px"
    },
    "size-md": {
      "$type": "dimension",
      "$value": "20px"
    },
    "size-lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "size-xl": {
      "$description": "展示型大图标四档（空态、结果页的主图标）：从这一档起不再对齐单行控件。",
      "$type": "dimension",
      "$value": "32px"
    },
    "size-2xl": {
      "$type": "dimension",
      "$value": "40px"
    },
    "size-3xl": {
      "$type": "dimension",
      "$value": "56px"
    },
    "size-4xl": {
      "$type": "dimension",
      "$value": "72px"
    },
    "stroke-light": {
      "$type": "dimension",
      "$value": "1.5px"
    },
    "stroke-regular": {
      "$type": "dimension",
      "$value": "2px"
    },
    "stroke-bold": {
      "$type": "dimension",
      "$value": "2.5px"
    },
    "baseline-shift": {
      "$type": "dimension",
      "$value": "-0.125em"
    },
    "mark-check": {
      "$type": "icon",
      "$value": "check"
    },
    "mark-edit": {
      "$type": "icon",
      "$value": "pencil"
    },
    "mark-minus": {
      "$type": "icon",
      "$value": "minus"
    },
    "mark-plus": {
      "$type": "icon",
      "$value": "plus"
    },
    "mark-close": {
      "$type": "icon",
      "$value": "x"
    },
    "mark-download": {
      "$type": "icon",
      "$value": "download"
    },
    "mark-chevron-down": {
      "$type": "icon",
      "$value": "chevron-down"
    },
    "mark-chevron-up": {
      "$type": "icon",
      "$value": "chevron-up"
    },
    "mark-chevron-left": {
      "$type": "icon",
      "$value": "chevron-left"
    },
    "mark-chevron-right": {
      "$type": "icon",
      "$value": "chevron-right"
    },
    "mark-chevrons-left": {
      "$type": "icon",
      "$value": "chevrons-left"
    },
    "mark-chevrons-right": {
      "$type": "icon",
      "$value": "chevrons-right"
    },
    "mark-arrow-up": {
      "$type": "icon",
      "$value": "arrow-up"
    },
    "mark-arrow-down": {
      "$type": "icon",
      "$value": "arrow-down"
    },
    "mark-sort": {
      "$type": "icon",
      "$value": "arrow-up-down"
    },
    "mark-sort-asc": {
      "$type": "icon",
      "$value": "arrow-up"
    },
    "mark-sort-desc": {
      "$type": "icon",
      "$value": "arrow-down"
    },
    "mark-info": {
      "$type": "icon",
      "$value": "info"
    },
    "mark-warning": {
      "$type": "icon",
      "$value": "triangle-alert"
    },
    "mark-star": {
      "$description": "评分条目的默认星形。",
      "$type": "icon",
      "$value": "star"
    },
    "mark-eye": {
      "$type": "icon",
      "$value": "eye"
    },
    "mark-eye-off": {
      "$type": "icon",
      "$value": "eye-off"
    },
    "mark-zoom-in": {
      "$type": "icon",
      "$value": "zoom-in"
    },
    "mark-zoom-out": {
      "$type": "icon",
      "$value": "zoom-out"
    },
    "mark-rotate-left": {
      "$type": "icon",
      "$value": "rotate-left"
    },
    "mark-rotate-right": {
      "$type": "icon",
      "$value": "rotate-right"
    },
    "mark-flip-horizontal": {
      "$type": "icon",
      "$value": "flip-horizontal"
    },
    "mark-flip-vertical": {
      "$type": "icon",
      "$value": "flip-vertical"
    },
    "mark-maximize": {
      "$description": "把面板铺满可视区。四角箭头朝外，与朝内的 mark-restore 成对。",
      "$type": "icon",
      "$value": "maximize"
    },
    "mark-restore": {
      "$description": "把铺满或收拢的面板还原成常规尺寸。四角箭头朝内，与朝外的 mark-maximize 成对。",
      "$type": "icon",
      "$value": "minimize"
    },
    "mark-play": {
      "$description": "开始自动播放。三角朝右，与 mark-pause 成对。",
      "$type": "icon",
      "$value": "play"
    },
    "mark-pause": {
      "$description": "停住自动播放。两条竖杠，与 mark-play 成对。",
      "$type": "icon",
      "$value": "pause"
    },
    "mark-calendar": {
      "$description": "展开挑日子的面板。月历方格，与挑时刻的 mark-clock 成对。",
      "$type": "icon",
      "$value": "calendar"
    },
    "mark-clock": {
      "$description": "展开挑时刻的面板。表盘带指针，与挑日子的 mark-calendar 成对。",
      "$type": "icon",
      "$value": "clock"
    },
    "mark-ellipsis": {
      "$description": "折起来的那一段：分页里被折掉的页码、面包屑里被折掉的层级。三点横排。",
      "$type": "icon",
      "$value": "ellipsis"
    },
    "mark-required": {
      "$type": "string",
      "$value": "'*'"
    }
  },
  "field": {
    "py": {
      "$type": "dimension",
      "$value": "{space.2}"
    }
  },
  "action": {
    "brand-solid": {
      "$description": "主动作的稳定品牌底色；不随主题翻转，始终与浅色前景配对。",
      "$type": "color",
      "$value": "{color.brand.600}"
    },
    "brand-solid-hover": {
      "$type": "color",
      "$value": "{color.brand.700}"
    },
    "brand-solid-active": {
      "$type": "color",
      "$value": "{color.brand.800}"
    },
    "on-brand-solid": {
      "$type": "color",
      "$value": "{color.neutral.0}"
    }
  },
  "list": {
    "$description": "条目内衬两把尺：item-* 给页内的列表行（宽），option-* 给浮层里的条目（窄）——菜单项、下拉选项、树行、时间列。两者差一倍，硬凑到一把尺上会让下拉选项变得像列表行那么高。",
    "item-py-sm": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "item-py-md": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "item-py-lg": {
      "$type": "dimension",
      "$value": "{space.4}"
    },
    "item-px-sm": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "item-px-md": {
      "$type": "dimension",
      "$value": "{space.4}"
    },
    "item-px-lg": {
      "$type": "dimension",
      "$value": "{space.5}"
    },
    "option-py-sm": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "option-py-md": {
      "$type": "dimension",
      "$value": "{space.1_5}"
    },
    "option-py-lg": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "option-gap": {
      "$type": "dimension",
      "$value": "{space.0_5}"
    }
  },
  "table": {
    "cell-py-sm": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "cell-py-md": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "cell-py-lg": {
      "$type": "dimension",
      "$value": "{space.3}"
    }
  },
  "shape": {
    "$description": "形状身份。inset / control / surface / overlay 是 4 / 8 / 12px 的小圆角阶梯；circle 与 pill 是形状身份，不进入阶梯。",
    "inset": {
      "$description": "嵌在控件里的内层：菜单项、标签内部、微型状态块。",
      "$type": "dimension",
      "$value": "{radius.sm}"
    },
    "control": {
      "$description": "控件本体：Button、Input、Select Trigger、Toggle、分页按钮。",
      "$type": "dimension",
      "$value": "{radius.sm}"
    },
    "surface": {
      "$description": "成面的静态容器：Card、Alert、Panel、列表容器。",
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "overlay": {
      "$description": "脱离文档流的浮层：Popover、Menu、Dialog、Drawer、Toast。",
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "circle": {
      "$description": "正圆：头像、圆形图标按钮、单选指示器。",
      "$type": "dimension",
      "$value": "50%"
    },
    "pill": {
      "$description": "胶囊：Badge、Tag、Segmented 轨道等具有胶囊身份的对象。",
      "$type": "dimension",
      "$value": "{radius.full}"
    }
  },
  "ring": {
    "width": {
      "$type": "dimension",
      "$value": "{stroke.thick}"
    },
    "offset": {
      "$description": "聚焦环画在元素自己那一圈：往内收一个环宽，环的外沿与元素的边框外沿重合，聚焦前后绘制外沿一样大。",
      "$type": "dimension",
      "$value": "calc(-1 * {ring.width})"
    }
  },
  "state": {
    "disabled-opacity": {
      "$type": "number",
      "$value": 0.5
    },
    "dragging-opacity": {
      "$type": "number",
      "$value": 0.6
    }
  },
  "elevation": {
    "raised": {
      "$type": "shadow",
      "$value": "{shadow.sm}"
    },
    "lifted": {
      "$description": "被指针拎起来、正跟着手移动的东西：滑杆拇指、拖动中的排序项、取色器的拇指。它比贴在页面上的 raised 抬得高，又没到 floating 那一层——floating 是 portal 出去的锚定浮层，抬到那一档，拖动中的拇指会和下拉面板一样重。三层与投影色都照 shadow.* 那份配方，取值逐层落在 raised 与 floating 中间：主层偏移 2→3→4、模糊 3→6→8，环境层偏移 3→6→10。不写 shadow.* 原语是因为原语只有 sm / md / lg / xl 四档，两档之间没有位置。",
      "$type": "shadow",
      "$value": "0 1px 2px -0.5px oklch(0.145 0.005 258 / 0.06), 0 3px 6px -2px oklch(0.145 0.005 258 / 0.06), 0 6px 12px -5px oklch(0.145 0.005 258 / 0.05)"
    },
    "floating": {
      "$type": "shadow",
      "$value": "{shadow.md}"
    },
    "sheet": {
      "$type": "shadow",
      "$value": "{shadow.lg}"
    }
  },
  "motion": {
    "duration-enter": {
      "$description": "出现：节点挂载时的淡入，以及只由幅度令牌驱动的小幅位移与缩放。几何变化不走这一支，走 duration-move / nudge / expand / collapse / slide。",
      "$type": "duration",
      "$value": "{duration.normal}"
    },
    "duration-exit": {
      "$description": "消失：节点卸载前的淡出，以及只由幅度令牌驱动的小幅位移与缩放。几何变化不走这一支。",
      "$type": "duration",
      "$value": "{duration.fast}"
    },
    "duration-micro": {
      "$description": "状态换色：背景、描边、前景、阴影与透明度。几何变化不走这一支。",
      "$type": "duration",
      "$value": "{duration.fast}"
    },
    "duration-move": {
      "$description": "元素换位与尺寸变化：选中指示器滑移、进度增长、堆叠重排、视口长高。",
      "$type": "duration",
      "$value": "{duration.normal}"
    },
    "duration-expand": {
      "$description": "内容展开：披露内容的高度增长，以及随内容转向的展开指示器。",
      "$type": "duration",
      "$value": "{duration.normal}"
    },
    "duration-collapse": {
      "$description": "内容收起：比展开短一档，收起是让路。",
      "$type": "duration",
      "$value": "{duration.fast}"
    },
    "duration-slide": {
      "$description": "尺度大的位移与容器级尺寸变化：抽屉推入推出、轮播换页、面板长高。只此一支，不按场景再分名。",
      "$type": "duration",
      "$value": "{duration.slow}"
    },
    "duration-nudge": {
      "$description": "紧跟操作的小幅几何变化：开关滑块、勾选标记、展开箭头原地的位移、缩放与旋转，拖拽时的让位与查看器的缩放平移。",
      "$type": "duration",
      "$value": "{duration.fast}"
    },
    "duration-press": {
      "$description": "统一点击触感的按下段：scale 1 → 0.97，背景进入 active。",
      "$type": "duration",
      "$value": "{duration.fast}"
    },
    "duration-release": {
      "$description": "统一点击触感的释放段：scale 0.97 → 1，背景回到 hover / rest。",
      "$type": "duration",
      "$value": "{duration.normal}"
    },
    "duration-attention": {
      "$description": "注意动效播一遍：抖动、脉冲、心跳这类从静息态出发再回到静息态的强调，只给 @xihan-ui/animations 的注意预设用，核心组件不用注意动效。减弱动效下预设不播，归 1ms。",
      "$type": "duration",
      "$value": "calc({duration.slow} * 2)"
    },
    "stagger-step": {
      "$description": "交错进场的相邻两项间隔。派生自 duration-enter 的五分之一，改进场时长它跟着走。减弱档显式归 0ms，不靠 calc 传递。",
      "$type": "duration",
      "$value": "calc({duration.normal} / 5)"
    },
    "ease-continuous": {
      "$description": "元素在屏内被推到新位置：起终点都在可视区内，所以起步就带速度、收尾再减速。循环动画不走这一条，走 ease-loop。",
      "$type": "cubicBezier",
      "$value": "{ease.standard}"
    },
    "ease-loop": {
      "$description": "无限循环的匀速动画：加载环、流光、跑马灯。带缓动的曲线会让每一圈忽快忽慢，所以这一档恒是匀速；背后刻意不设原语——匀速没有可调余地，立了原语只是给令牌层加一个没人该拧的旋钮。",
      "$type": "cubicBezier",
      "$value": "linear"
    },
    "ease-enter": {
      "$type": "cubicBezier",
      "$value": "{ease.out}"
    },
    "ease-enter-strong": {
      "$description": "入场与展开用的强减速曲线，位移与高度变化走这一条。",
      "$type": "cubicBezier",
      "$value": "{ease.out-strong}"
    },
    "ease-exit": {
      "$type": "cubicBezier",
      "$value": "{ease.in}"
    },
    "ease-slide": {
      "$description": "尺度大的位移与尺寸变化。与 ease-continuous 的分界：位移量以百分比或视口尺度计、或一端在可视区外的走这一条，像素级的屏内推移走 continuous。",
      "$type": "cubicBezier",
      "$value": "{ease.out-fluid}"
    },
    "ease-sweep": {
      "$description": "往返型无限循环：进度条的不定态、骨架呼吸、加载条的游标。单向循环仍走 ease-loop——匀速是转圈的硬要求，而往返在折返点需要两端减速，linear 在那里是瞬时反向、读成硬弹。",
      "$type": "cubicBezier",
      "$value": "{ease.in-out}"
    },
    "ease-press": {
      "$description": "按下段的曲线：稳定进入，不带弹簧。",
      "$type": "cubicBezier",
      "$value": "{ease.standard}"
    },
    "ease-release": {
      "$description": "释放段的曲线：快速恢复，末端柔和。",
      "$type": "cubicBezier",
      "$value": "{ease.out-strong}"
    },
    "ease-breathe": {
      "$description": "呼吸：进行中、给不出进度的状态点的明暗起伏。只给 xh-breathe 用。",
      "$type": "cubicBezier",
      "$value": "{ease.sine-in-out}"
    },
    "loop-spin": {
      "$description": "旋转指示器转一圈的周期。减弱动效下由各皮肤停掉动画，周期本身不降级。",
      "$type": "duration",
      "$value": "640ms"
    },
    "loop-caret": {
      "$description": "文本光标闪一次的周期。减弱动效下由皮肤停掉动画，光标停在实心。",
      "$type": "duration",
      "$value": "1000ms"
    },
    "loop-shimmer": {
      "$description": "骨架屏与在跑文字的微光扫过一遍的周期。减弱动效下由皮肤停掉动画。",
      "$type": "duration",
      "$value": "1600ms"
    },
    "loop-breathe": {
      "$description": "呼吸一个周期：约每分钟 16 次，接近静息呼吸的节律。减弱动效下由皮肤停掉动画，周期本身不降级。",
      "$type": "duration",
      "$value": "3600ms"
    },
    "scale-breathe": {
      "$description": "呼吸吸气前最小的一档：圆点在 0.82 与 1 之间起伏。减弱档归 1。",
      "$type": "number",
      "$value": 0.82
    },
    "scale-halo": {
      "$description": "呼吸光环外扩到的比例，从圆点本身的大小扩到它的 2.6 倍后淡尽。减弱档归 1。",
      "$type": "number",
      "$value": 2.6
    },
    "ease-settle": {
      "$description": "小件的过冲落位：勾、圆点、开关拇指、按压释放。只许打在 scale / rotate 上，且部件短边不超过 32px。",
      "$type": "cubicBezier",
      "$value": "{ease.out-back}"
    },
    "ease-emphasis": {
      "$description": "表现性进场：@xihan-ui/animations 的上浮、落入、旋入预设取这一条。组件皮肤不用，组件的出现走 ease-enter / ease-enter-strong。",
      "$type": "cubicBezier",
      "$value": "{ease.emphasized}"
    },
    "distance-sm": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "distance-md": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "distance-lg": {
      "$description": "表现性进场的位移：@xihan-ui/animations 的淡入位移预设取这一档，上浮、落入取它的 1.5 倍。组件皮肤不用。减弱动效下归零。",
      "$type": "dimension",
      "$value": "{space.4}"
    },
    "travel": {
      "$description": "整幅位移：面板从所在边整条推入推出（抽屉、轻提示），以自身尺寸的百分比计。减弱动效下归零，进出场只剩淡变。",
      "$type": "dimension",
      "$value": "100%"
    },
    "travel-opacity": {
      "$description": "整幅位移起止两端的不透明度：缺省 1，面板整条推入推出、不淡变；减弱动效下 0，整幅位移归零后进出场改由淡变表达。",
      "$type": "number",
      "$value": 1
    },
    "scale-enter": {
      "$type": "number",
      "$value": 0.96
    },
    "scale-exit": {
      "$description": "退场缩到的比例。比进场的起点更靠近 1：退场不是进场倒放，收得更浅才不显得被吸走。",
      "$type": "number",
      "$value": 0.98
    },
    "scale-stack": {
      "$description": "叠放的一摞里每往后一层保留的比例，后层按层深逐层收拢（Toast 的收起态）。减弱动效下为 1：层与层只靠位移分开，不缩放。",
      "$type": "number",
      "$value": 0.95
    },
    "scale-press": {
      "$type": "number",
      "$value": 0.97
    },
    "scale-drag": {
      "$description": "拖拽中的拇指放大比例（滑杆、取色器）。",
      "$type": "number",
      "$value": 1.12
    },
    "scale-squash": {
      "$description": "液态形变里被拉长的块在另一个方向上最多压到的比例，表达体积守恒（液态档的双沿指示器、按下的液态面）。",
      "$type": "number",
      "$value": 0.86
    },
    "spring-snappy": {
      "$description": "干脆的弹簧：阻尼比 0.77，超调约 2.2%，落定约 370ms。质量恒为 1，只登记刚度与阻尼。减弱动效下由 JS 直接落到终态，不走 reduce 档。",
      "stiffness": { "$type": "number", "$value": 380 },
      "damping": { "$type": "number", "$value": 30 }
    },
    "spring-smooth": {
      "$description": "手势松手的缺省弹簧：阻尼比 0.87，超调约 0.4%，落定约 280ms。归位、快甩与面板弹回都取它。",
      "stiffness": { "$type": "number", "$value": 300 },
      "damping": { "$type": "number", "$value": 30 }
    },
    "spring-gentle": {
      "$description": "临界阻尼的慢弹簧：不超调，落定约 570ms。",
      "stiffness": { "$type": "number", "$value": 170 },
      "damping": { "$type": "number", "$value": 26 }
    },
    "spring-bouncy": {
      "$description": "明显回弹的弹簧：阻尼比 0.45，超调约 20%。超过核心组件 3% 的超调上限，只供作者与功能包使用。",
      "stiffness": { "$type": "number", "$value": 400 },
      "damping": { "$type": "number", "$value": 18 }
    },
    "spring-stiff": {
      "$description": "硬弹簧：阻尼比 0.86，超调约 0.5%，落定约 195ms。越界回弹取它。",
      "stiffness": { "$type": "number", "$value": 600 },
      "damping": { "$type": "number", "$value": 42 }
    },
    "spring-toggle": {
      "$description": "liquid 档的切换滑块：阻尼比 0.63，超调约 7.5%，在 liquid 档 8% 的上限之内。",
      "stiffness": { "$type": "number", "$value": 420 },
      "damping": { "$type": "number", "$value": 26 }
    },
    "spring-lead": {
      "$description": "liquid 档双沿指示器的前沿：去向那一侧的沿，超调约 2.9%，落定约 310ms。",
      "stiffness": { "$type": "number", "$value": 520 },
      "damping": { "$type": "number", "$value": 34 }
    },
    "spring-trail": {
      "$description": "liquid 档双沿指示器的后沿：比前沿软，追随前沿并在移动中把指示器拉长，超调约 0.9%，落定约 485ms。",
      "stiffness": { "$type": "number", "$value": 210 },
      "damping": { "$type": "number", "$value": 24 }
    },
    "spring-merge": {
      "$description": "liquid 档的融合分离：液态组里的块从源块中分出来、收起时融回，超调约 5.8%，在 liquid 档 8% 的上限之内。",
      "stiffness": { "$type": "number", "$value": 320 },
      "damping": { "$type": "number", "$value": 24 }
    }
  },
