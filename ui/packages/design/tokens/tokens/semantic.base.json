  "elevation": {
    "raised": {
      "$type": "shadow",
      "$value": "{shadow.sm}"
    },
    "lifted": {
      "$description": "被指针拎起来、正跟着手移动的东西：滑杆拇指、拖动中的排序项、取色器的拇指。它比贴在页面上的 raised 抬得高，又没到 floating 那一层——floating 是 portal 出去的锚定浮层，抬到那一档，拖动中的拇指会和下拉面板一样重。取值逐位落在两档中间：偏移 1→2→4、模糊 2→4→8、收缩 0→-1→-2、主层不透明度 0.05→0.08→0.1；第二层是 floating 第二层的一半。不写 shadow.* 原语是因为原语只有 sm / md / lg / xl 四档，两档之间没有位置。",
      "$type": "shadow",
      "$value": "0 2px 4px -1px oklch(0 0 0 / 0.08), 0 1px 2px -1px oklch(0 0 0 / 0.05)"
    },
    "floating": {
      "$type": "shadow",
      "$value": "{shadow.md}"
    },
    "sheet": {
      "$type": "shadow",
      "$value": "{shadow.lg}"
    }
  },
  "motion": {
    "duration-enter": {
      "$type": "duration",
      "$value": "{duration.normal}"
    },
    "duration-exit": {
      "$type": "duration",
      "$value": "{duration.fast}"
    },
    "duration-micro": {
      "$type": "duration",
      "$value": "{duration.fast}"
    },
    "duration-slide": {
      "$description": "尺度大的位移与容器级尺寸变化：抽屉推入推出、轮播换页、面板长高。只此一支，不按场景再分名。",
      "$type": "duration",
      "$value": "{duration.slow}"
    },
    "duration-nudge": {
      "$description": "几何类微交互：小件被推一下就到位，比 duration-micro 长一档，让位移看得清。",
      "$type": "duration",
      "$value": "{duration.normal}"
    },
    "stagger-step": {
      "$description": "交错进场的相邻两项间隔。派生自 duration-enter 的五分之一，改进场时长它跟着走。减弱档显式归 0ms，不靠 calc 传递。",
      "$type": "duration",
      "$value": "calc({duration.normal} / 5)"
    },
    "ease-continuous": {
      "$description": "元素在屏内被推到新位置：起终点都在可视区内，所以起步就带速度、收尾再减速。循环动画不走这一条，走 ease-loop。",
      "$type": "cubicBezier",
      "$value": "{ease.standard}"
    },
    "ease-loop": {
      "$description": "无限循环的匀速动画：加载环、流光、跑马灯。带缓动的曲线会让每一圈忽快忽慢，所以这一档恒是匀速；背后刻意不设原语——匀速没有可调余地，立了原语只是给令牌层加一个没人该拧的旋钮。",
      "$type": "cubicBezier",
      "$value": "linear"
    },
    "ease-enter": {
      "$type": "cubicBezier",
      "$value": "{ease.out}"
    },
    "ease-enter-strong": {
      "$description": "入场与展开用的强减速曲线，位移与高度变化走这一条。",
      "$type": "cubicBezier",
      "$value": "{ease.out-strong}"
    },
    "ease-exit": {
      "$type": "cubicBezier",
      "$value": "{ease.in}"
    },
    "ease-slide": {
      "$description": "尺度大的位移与尺寸变化。与 ease-continuous 的分界：位移量以百分比或视口尺度计、或一端在可视区外的走这一条，像素级的屏内推移走 continuous。",
      "$type": "cubicBezier",
      "$value": "{ease.out-fluid}"
    },
    "ease-sweep": {
      "$description": "往返型无限循环：进度条的不定态、骨架呼吸、加载条的游标。单向循环仍走 ease-loop——匀速是转圈的硬要求，而往返在折返点需要两端减速，linear 在那里是瞬时反向、读成硬弹。",
      "$type": "cubicBezier",
      "$value": "{ease.in-out}"
    },
    "ease-settle": {
      "$description": "小件的过冲落位：勾、圆点、开关拇指、按压释放。只许打在 scale / rotate 上，且部件短边不超过 32px。",
      "$type": "cubicBezier",
      "$value": "{ease.out-back}"
    },
