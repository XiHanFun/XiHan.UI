{
  "control": {
    "h-sm": {
      "$type": "dimension",
      "$value": "28px"
    },
    "h-md": {
      "$type": "dimension",
      "$value": "32px"
    },
    "h-lg": {
      "$type": "dimension",
      "$value": "40px"
    },
    "px-sm": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "px-md": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "px-lg": {
      "$type": "dimension",
      "$value": "{space.4}"
    },
    "gap-sm": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "gap-md": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "gap-lg": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "action-size": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "indicator-size": {
      "$type": "dimension",
      "$value": "1rem"
    }
  },
  "scrollbar": {
    "thickness-sm": {
      "$type": "dimension",
      "$value": "6px"
    },
    "thickness-md": {
      "$type": "dimension",
      "$value": "10px"
    },
    "thickness-lg": {
      "$type": "dimension",
      "$value": "14px"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "glyph": {
    "size-sm": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "size-md": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "size-lg": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "stroke-light": {
      "$type": "dimension",
      "$value": "1.5px"
    },
    "stroke-regular": {
      "$type": "dimension",
      "$value": "2px"
    },
    "stroke-bold": {
      "$type": "dimension",
      "$value": "2.5px"
    },
    "baseline-shift": {
      "$type": "dimension",
      "$value": "-0.125em"
    },
    "mark-check": {
      "$type": "icon",
      "$value": "check"
    },
    "mark-minus": {
      "$type": "icon",
      "$value": "minus"
    },
    "mark-plus": {
      "$type": "icon",
      "$value": "plus"
    },
    "mark-close": {
      "$type": "icon",
      "$value": "x"
    },
    "mark-chevron-down": {
      "$type": "icon",
      "$value": "chevron-down"
    },
    "mark-chevron-up": {
      "$type": "icon",
      "$value": "chevron-up"
    },
    "mark-chevron-left": {
      "$type": "icon",
      "$value": "chevron-left"
    },
    "mark-chevron-right": {
      "$type": "icon",
      "$value": "chevron-right"
    },
    "mark-sort": {
      "$type": "icon",
      "$value": "arrow-up-down"
    },
    "mark-sort-asc": {
      "$type": "icon",
      "$value": "arrow-up"
    },
    "mark-sort-desc": {
      "$type": "icon",
      "$value": "arrow-down"
    },
    "mark-info": {
      "$type": "icon",
      "$value": "info"
    },
    "mark-warning": {
      "$type": "icon",
      "$value": "triangle-alert"
    },
    "mark-zoom-in": {
      "$type": "icon",
      "$value": "zoom-in"
    },
    "mark-zoom-out": {
      "$type": "icon",
      "$value": "zoom-out"
    },
    "mark-rotate-left": {
      "$type": "icon",
      "$value": "rotate-left"
    },
    "mark-rotate-right": {
      "$type": "icon",
      "$value": "rotate-right"
    },
    "mark-flip-horizontal": {
      "$type": "icon",
      "$value": "flip-horizontal"
    },
    "mark-flip-vertical": {
      "$type": "icon",
      "$value": "flip-vertical"
    },
    "mark-required": {
      "$type": "string",
      "$value": "'*'"
    }
  },
  "field": {
    "py": {
      "$type": "dimension",
      "$value": "{space.2}"
    }
  },
  "list": {
    "item-py-sm": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "item-py-md": {
      "$type": "dimension",
      "$value": "{space.3}"
    },
    "item-py-lg": {
      "$type": "dimension",
      "$value": "{space.4}"
    }
  },
  "table": {
    "cell-py-sm": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "cell-py-md": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "cell-py-lg": {
      "$type": "dimension",
      "$value": "{space.3}"
    }
  },
  "shape": {
    "inset": {
      "$type": "dimension",
      "$value": "{radius.sm}"
    },
    "control": {
      "$type": "dimension",
      "$value": "{radius.md}"
    },
    "surface": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "pill": {
      "$type": "dimension",
      "$value": "{radius.full}"
    }
  },
  "ring": {
    "width": {
      "$type": "dimension",
      "$value": "{stroke.thick}"
    },
    "offset": {
      "$type": "dimension",
      "$value": "2px"
    }
  },
  "state": {
    "disabled-opacity": {
      "$type": "number",
      "$value": 0.5
    }
  },
  "elevation": {
    "0": {
      "$type": "shadow",
      "$value": "none"
    },
    "1": {
      "$type": "shadow",
      "$value": "{shadow.sm}"
    },
    "2": {
      "$type": "shadow",
      "$value": "{shadow.md}"
    },
    "3": {
      "$type": "shadow",
      "$value": "{shadow.lg}"
    },
    "4": {
      "$type": "shadow",
      "$value": "{shadow.xl}"
    }
  },
  "motion": {
    "duration-enter": {
      "$type": "duration",
      "$value": "{duration.normal}"
    },
    "duration-exit": {
      "$type": "duration",
      "$value": "{duration.fast}"
    },
    "duration-micro": {
      "$type": "duration",
      "$value": "{duration.fast}"
    },
    "ease-enter": {
      "$type": "cubicBezier",
      "$value": "{ease.out}"
    },
    "ease-exit": {
      "$type": "cubicBezier",
      "$value": "{ease.in}"
    },
    "distance-sm": {
      "$type": "dimension",
      "$value": "{space.1}"
    },
    "distance-md": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "scale-enter": {
      "$type": "number",
      "$value": 0.96
    },
    "scale-press": {
      "$type": "number",
      "$value": 0.97
    }
  },
  "spin": {
    "$description": "旋转指示器转一圈的周期。减弱动效由各皮肤停掉动画，不走 reduce 档重映射。",
    "duration": {
      "$type": "duration",
      "$value": "640ms"
    }
  },
  "layer": {
    "sticky": {
      "$type": "number",
      "$value": "{z.sticky}"
    },
    "drawer": {
      "$type": "number",
      "$value": "{z.modal}"
    },
    "modal": {
      "$type": "number",
      "$value": "{z.modal}"
    },
    "popover": {
      "$type": "number",
      "$value": "{z.popover}"
    },
    "toast": {
      "$type": "number",
      "$value": "{z.toast}"
    },
    "tooltip": {
      "$type": "number",
      "$value": "{z.tooltip}"
    }
  },
  "section": {
    "py": {
      "$type": "dimension",
      "$value": "{space.5}"
    }
  },
  "stack": {
    "gap-md": {
      "$type": "dimension",
      "$value": "{space.4}"
    }
  },
  "overlay": {
    "arrow-size": {
      "$type": "dimension",
      "$value": "{space.2}"
    },
    "min-w": {
      "$type": "dimension",
      "$value": "12rem"
    },
    "menu-min-w": {
      "$type": "dimension",
      "$value": "10rem"
    },
    "menu-max-h": {
      "$type": "dimension",
      "$value": "20rem"
    },
    "max-w-sm": {
      "$type": "dimension",
      "$value": "16rem"
    },
    "max-w": {
      "$type": "dimension",
      "$value": "20rem"
    },
    "max-w-lg": {
      "$type": "dimension",
      "$value": "24rem"
    },
    "max-h": {
      "$type": "dimension",
      "$value": "16rem"
    }
  },
  "text": {
    "label-size": {
      "$type": "dimension",
      "$value": "{font-size.md}"
    },
    "label-weight": {
      "$type": "number",
      "$value": "{font-weight.medium}"
    },
    "body-size": {
      "$type": "dimension",
      "$value": "{font-size.md}"
    },
    "body-leading": {
      "$type": "number",
      "$value": "{leading.normal}"
    },
    "body-weight": {
      "$type": "number",
      "$value": "{font-weight.regular}"
    },
    "heading-3-size": {
      "$type": "dimension",
      "$value": "{font-size.xl}"
    },
    "heading-3-weight": {
      "$type": "number",
      "$value": "{font-weight.semibold}"
    }
  }
}
