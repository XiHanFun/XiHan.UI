{
  "$description": "浅色 · 高对比档（data-contrast='more'）。只覆盖边界一族：这一档的判据是每条边界对 bg.canvas 与 bg.surface 都不低于 4.5:1，与正文 AA 同一条线，取值一律从既有中性色阶里挑。",
  "border": {
    "default": { "$type": "color", "$value": "{color.neutral.550}" },
    "subtle": { "$type": "color", "$value": "{color.neutral.500}" },
    "strong": { "$type": "color", "$value": "{color.neutral.600}" },
    "control": { "$type": "color", "$value": "{color.neutral.600}" },
    "control-hover": { "$type": "color", "$value": "{color.neutral.700}" },
    "invalid": { "$type": "color", "$value": "{color.danger.700}" },
    "at-limit": { "$type": "color", "$value": "{color.warning.800}" }
  },
  "material": {
    "soft": {
      "$description": "高对比档在当前作用域重新声明依赖边界的 M1 令牌，避免 :root 上已经解析的别名穿不过嵌套轴。",
      "border": { "$type": "color", "$value": "{border.subtle}" },
      "highlight": { "$type": "color", "$value": "oklch(0 0 0 / 0)" },
      "separator": { "$type": "color", "$value": "{border.subtle}" }
    }
  }
}
