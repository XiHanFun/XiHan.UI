{
  "bg": {
    "page": {
      "$description": "页面底：面之下的那一层，铺满视口、不承载任何部件。比 {bg.surface} 暗一档，面才浮得出来。控件盒的底是 {bg.canvas}，两者取值不同。",
      "$type": "color",
      "$value": "{color.neutral.50}"
    },
    "canvas": {
      "$type": "color",
      "$value": "{color.neutral.0}"
    },
    "surface": {
      "$type": "color",
      "$value": "{color.neutral.0}"
    },
    "surface-raised": {
      "$type": "color",
      "$value": "{color.neutral.0}"
    },
    "subtle": {
      "$type": "color",
      "$value": "{color.neutral.100}"
    },
    "subtle-hover": {
      "$type": "color",
      "$value": "{color.neutral.200}"
    },
    "subtle-active": {
      "$type": "color",
      "$value": "{color.neutral.300}"
    },
    "muted": {
      "$type": "color",
      "$value": "{color.neutral.100}"
    },
    "brand": {
      "$type": "color",
      "$value": "{color.brand.600}"
    },
    "brand-hover": {
      "$type": "color",
      "$value": "{color.brand.700}"
    },
    "brand-active": {
      "$type": "color",
      "$value": "{color.brand.800}"
    },
    "brand-subtle": {
      "$description": "品牌淡底：选中与当前态的行面 / 段面。与 -hover（20%）、-active（28%）同一条曲线，也与语气层 --xh-_tone-subtle 的 12% 同式：写了 data-tone='brand' 与不写语气时兑出同一个颜色。兑的对象是 {bg.surface}：深色档 canvas 比 surface 还暗，兑 canvas 会让选中面陷进面里。",
      "$type": "color",
      "$value": "color-mix(in oklab, {bg.brand} 12%, {bg.surface})"
    },
    "brand-subtle-hover": {
      "$type": "color",
      "$value": "color-mix(in oklab, {bg.brand} 20%, {bg.surface})"
    },
    "brand-subtle-active": {
      "$type": "color",
      "$value": "color-mix(in oklab, {bg.brand} 28%, {bg.surface})"
    },
    "overlay": {
      "$type": "color",
      "$value": "oklch(0 0 0 / 0.45)"
    },
    "scrollbar-track": {
      "$type": "color",
      "$value": "oklch(0 0 0 / 0)"
    }
  },
  "fg": {
    "default": {
      "$type": "color",
      "$value": "{color.neutral.950}"
    },
    "muted": {
      "$type": "color",
      "$value": "{color.neutral.600}"
    },
    "subtle": {
      "$type": "color",
      "$value": "{color.neutral.550}"
    },
    "disabled": {
      "$type": "color",
      "$value": "{color.neutral.400}"
    },
    "on-brand": {
      "$type": "color",
      "$value": "{color.neutral.0}"
    },
    "on-brand-subtle": {
      "$description": "品牌淡底（{bg.brand-subtle} 及其 -hover / -active 三档）上的文字与字形。与语气层 --xh-_tone-fg 同式：往正文色兑到 60%，浅色态变深、深色态变浅。浅色实测压 12% / 20% / 28% 三档为 8.49 / 7.60 / 6.78；直接取 brand.700 在 28% 按下面只有 4.42，够不到 AA。",
      "$type": "color",
      "$value": "color-mix(in oklab, {bg.brand} 60%, {fg.default})"
    },
    "brand": {
      "$type": "color",
      "$value": "{color.brand.600}"
    },
    "brand-strong": {
      "$type": "color",
      "$value": "{color.brand.700}"
    },
    "success": {
      "$type": "color",
      "$value": "{color.success.700}"
    },
    "warning": {
      "$type": "color",
      "$value": "{color.warning.700}"
    },
    "info": {
      "$type": "color",
      "$value": "{color.info.700}"
    },
    "danger": {
      "$type": "color",
      "$value": "{color.danger.600}"
    },
    "danger-hover": {
      "$type": "color",
      "$value": "{color.danger.700}"
    },
    "scrollbar-thumb": {
      "$type": "color",
      "$value": "color-mix(in oklab, {fg.default} 15%, transparent)"
    },
    "scrollbar-thumb-hover": {
      "$type": "color",
      "$value": "color-mix(in oklab, {fg.default} 25%, transparent)"
    },
    "scrollbar-thumb-active": {
      "$type": "color",
      "$value": "color-mix(in oklab, {fg.default} 35%, transparent)"
    }
  },
  "border": {
    "default": {
      "$type": "color",
      "$value": "{color.neutral.200}"
    },
    "subtle": {
      "$type": "color",
      "$value": "{color.neutral.100}"
    },
    "strong": {
      "$type": "color",
      "$value": "{color.neutral.300}"
    },
    "control": {
      "$description": "控件边界（输入框壳、勾选框、单选圈、开关轨道、拖放区）。与装饰边界 {border.default} 同一档：字段与它旁边的浮层面板、卡片描边同色，页面里只有一种边线重量。1.26:1 达不到 WCAG 1.4.11 的 3:1，那条门槛留给高对比档（.more 换到 neutral.600）；缺省档靠占位文字、标签与聚焦环辨认控件。",
      "$type": "color",
      "$value": "{border.default}"
    },
    "control-hover": {
      "$description": "悬停把控件边界升两档：静息在 200，升到 300 只差一道明度、在 1px 描边上看不出来。",
      "$type": "color",
      "$value": "{color.neutral.400}"
    },
    "control-focus": {
      "$description": "聚焦时控件的描边色，与聚焦环同色；常态描边是 {border.control}，两者取值不同，聚焦才在描边上看得出来。",
      "$type": "color",
      "$value": "{ring.focus}"
    },
    "invalid": {
      "$type": "color",
      "$value": "{color.danger.600}"
    },
    "at-limit": {
      "$type": "color",
      "$value": "{color.warning.600}"
    }
  },
  "ring": {
    "focus": {
      "$description": "浅色面上的公共键盘焦点环。取 brand.600，确保压在 canvas、surface 与 neutral.200 高亮面上都达到 3:1 非文本对比。",
      "$type": "color",
      "$value": "{color.brand.600}"
    },
    "invalid": {
      "$type": "color",
      "$value": "{color.danger.500}"
    }
  },
  "gradient": {
    "brand": {
      "from": {
        "$description": "品牌渐变的起点。走向由用它的地方定，起点是对比度低的那一端。白底上实测 3.74:1，只够展示级字号。",
        "$type": "color",
        "$value": "{color.brand.500}"
      },
      "to": {
        "$description": "品牌渐变的终点，对比度高的那一端；白底上实测 6.48:1。两端跨 2 档色阶，明度差 0.135，渐变才看得出来。",
        "$type": "color",
        "$value": "{color.brand.700}"
      }
    }
  },
  "diff": {
    "added-bg": {
      "$type": "color",
      "$value": "oklch(0.94 0.05 150)"
    },
    "added-fg": {
      "$type": "color",
      "$value": "oklch(0.44 0.13 150)"
    },
    "removed-bg": {
      "$type": "color",
      "$value": "oklch(0.94 0.05 25)"
    },
    "removed-fg": {
      "$type": "color",
      "$value": "oklch(0.47 0.16 25)"
    }
  },
  "syntax": {
    "string": {
      "$type": "color",
      "$value": "oklch(0.52 0.13 165)"
    },
    "number": {
      "$type": "color",
      "$value": "oklch(0.5 0.13 70)"
    },
    "keyword": {
      "$type": "color",
      "$value": "oklch(0.5 0.2 300)"
    }
  },
  "chart": {
    "categorical-other": {
      "$description": "「其他」：合并进一个系列的剩余类目。中性色，照常可读，与每个分类色槽都拉得开。",
      "$type": "color",
      "$value": "{color.neutral.500}"
    },
    "deemphasis": {
      "$description": "强调一个系列时其余系列的颜色，也是缩放条里的缩略线。中性色，比任何分类色槽都弱。",
      "$type": "color",
      "$value": "{color.neutral.300}"
    },
    "sequential": {
      "$description": "顺序色阶（大小）的三个锚点：单色相由浅到深，小值贴近承载面，暗色下锚点翻转。标记只带色阶位置，皮肤在锚点之间以 oklch 插值；缺省色相与分类色槽 1 相同。",
      "start": {
        "$type": "color",
        "$value": "{color.indigo.100}"
      },
      "mid": {
        "$type": "color",
        "$value": "{color.indigo.400}"
      },
      "end": {
        "$type": "color",
        "$value": "{color.indigo.800}"
      }
    },
    "ordinal": {
      "1": {
        "$type": "color",
        "$value": "{color.indigo.900}"
      },
      "2": {
        "$type": "color",
        "$value": "{color.indigo.800}"
      },
      "3": {
        "$type": "color",
        "$value": "{color.indigo.700}"
      },
      "4": {
        "$type": "color",
        "$value": "{color.indigo.600}"
      },
      "5": {
        "$type": "color",
        "$value": "{color.indigo.500}"
      },
      "6": {
        "$type": "color",
        "$value": "{color.indigo.400}"
      },
      "$description": "有序色阶（漏斗阶段、档位）：单色相，1 对承载面最强、逐档减弱，最弱一档仍 ≥ 2:1。"
    },
    "diverging": {
      "$description": "发散色阶（高于 / 低于基线）：冷暖两臂等档，中点是贴近承载面的中性色。插值用 oklab：中点没有色相，oklch 插值会绕着色相环走出一段杂色。",
      "negative": {
        "$type": "color",
        "$value": "{color.amber.600}"
      },
      "center": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      },
      "positive": {
        "$type": "color",
        "$value": "{color.blue.600}"
      }
    },
    "rise": {
      "$description": "上涨（K 线、瀑布、盈亏）：缺省取成功色相。换成红涨绿跌时在主题边界上把 rise 与 fall 的取值对调。",
      "$type": "color",
      "$value": "{color.success.600}"
    },
    "fall": {
      "$description": "下跌：缺省取危险色相，与上涨在红色弱、绿色弱模拟下靠明度拉开。",
      "$type": "color",
      "$value": "{color.danger.700}"
    },
    "surface": {
      "$description": "图表的承载面：相邻填充之间的间隙与点外的描边环取它。图表放进淡底容器时由宿主改写，间隙才与底色一致。",
      "$type": "color",
      "$value": "{bg.surface}"
    },
    "grid": {
      "$description": "网格线：内部分隔，1px 实线。",
      "$type": "color",
      "$value": "{border.subtle}"
    },
    "axis": {
      "$description": "轴线与刻度线。",
      "$type": "color",
      "$value": "{border.default}"
    },
    "label": {
      "$description": "轴标签与数据标签：图表文字不用系列色。",
      "$type": "color",
      "$value": "{fg.muted}"
    },
    "crosshair": {
      "$description": "折线图的十字准线。",
      "$type": "color",
      "$value": "{fg.subtle}"
    },
    "band-highlight": {
      "$description": "柱图按类目悬停时整条类目带的淡底。",
      "$type": "color",
      "$value": "{bg.subtle}"
    }
  }
}
