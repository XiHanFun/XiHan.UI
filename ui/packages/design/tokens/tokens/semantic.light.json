  "material": {
    "elevated": {
      "$description": "M4 高层玻璃：为模态正文提供高遮蔽保护区；组件迁移另行完成，不能在本配方中假定任何组件已使用它。",
      "bg": {
        "$type": "color",
        "$value": "oklch(0.99 0.003 258 / {alpha.ultra-high})"
      },
      "backdrop": {
        "$description": "M4 只在最外层模态壳采样；内部正文、工具条和嵌套浮层不得重复模糊。",
        "$type": "string",
        "$value": "blur({blur.xl}) saturate(108%)"
      },
      "fg": {
        "$type": "color",
        "$value": "{fg.default}"
      },
      "focus-surface": {
        "$description": "获焦控制实际绘制的实体隔离底，不能把复杂透入背景当作焦点环背景。",
        "$type": "color",
        "$value": "{bg.surface}"
      },
      "border": {
        "$type": "color",
        "$value": "oklch(0.145 0.005 258 / 0.28)"
      },
      "highlight": {
        "$type": "color",
        "$value": "oklch(1 0 0 / 0.32)"
      },
      "shadow": {
        "$description": "近距 contact、中距 ambient 与远距 sheet 三层投影；高光另画，避免 inset 阴影叠边。",
        "$type": "shadow",
        "$value": "0 2px 4px -2px oklch(0.145 0.005 258 / 0.12), 0 12px 28px -12px oklch(0.145 0.005 258 / 0.16), 0 32px 64px -20px oklch(0.145 0.005 258 / 0.18)"
      },
      "separator": {
        "$type": "color",
        "$value": "oklch(0.145 0.005 258 / 0.2)"
      },
      "fg-muted": {
        "$description": "次要文字在最不利复杂背景合成后仍保持 AA 对比度。",
        "$type": "color",
        "$value": "{color.neutral.700}"
      }
    },
    "glass": {
      "$description": "M3 浮动玻璃：独立光学层与不透明文字；不用于表单或密集表格的默认背景。",
      "bg": {
        "$type": "color",
        "$value": "oklch(0.99 0.003 258 / {alpha.medium})"
      },
      "backdrop": {
        "$description": "固定光学采样，仅用于浮动创作表面；不要动画滤镜或叠加多层采样。",
        "$type": "string",
        "$value": "blur({blur.lg}) saturate(112%)"
      },
      "fg": {
        "$type": "color",
        "$value": "{fg.default}"
      },
      "focus-surface": {
        "$description": "获焦控件必须实际绘制的实体隔离底。",
        "$type": "color",
        "$value": "{bg.surface}"
      },
      "border": {
        "$type": "color",
        "$value": "oklch(0.145 0.005 258 / 0.24)"
      },
      "highlight": {
        "$type": "color",
        "$value": "oklch(1 0 0 / 0.3)"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "0 3px 6px -3px oklch(0.145 0.005 258 / 0.12), 0 16px 40px -14px oklch(0.145 0.005 258 / 0.18)"
      },
      "separator": {
        "$type": "color",
        "$value": "oklch(0.145 0.005 258 / 0.18)"
      },
      "fg-muted": {
        "$description": "提高次要文字保护，覆盖最不利背景合成。",
        "$type": "color",
        "$value": "{color.neutral.700}"
      }
    },
    "$description": "材质配方是组件皮肤的单一视觉入口；组件不再分别拼背景、边界和投影。M1 Soft Surface 保持不透明，不使用 backdrop blur，适合 Card 等内容容器。",
    "soft": {
      "bg": {
        "$description": "M1 柔和面的实体底。略低于纯白表面，靠细微明度差而不是透明度分层。",
        "$type": "color",
        "$value": "oklch(0.995 0.001 258)"
      },
      "backdrop": {
        "$description": "M1 不模糊背后内容；消费方可直接把本令牌交给 backdrop-filter。",
        "$type": "string",
        "$value": "none"
      },
      "border": {
        "$type": "color",
        "$value": "{border.subtle}"
      },
      "highlight": {
        "$description": "M1 顶边或内边高光；只画在独立光学层，不改变正文透明度。",
        "$type": "color",
        "$value": "oklch(1 0 0 / 0.72)"
      },
      "shadow": {
        "$description": "M1 的贴面层与环境层；不含 inset 高光，避免消费方组合 highlight 时重复画边。",
        "$type": "shadow",
        "$value": "0 1px 1px -0.5px oklch(0.145 0.005 258 / 0.04), 0 4px 10px -6px oklch(0.145 0.005 258 / 0.05)"
      },
      "separator": {
        "$type": "color",
        "$value": "{border.subtle}"
      },
      "fg": {
        "$type": "color",
        "$value": "{fg.default}"
      },
      "fg-muted": {
        "$type": "color",
        "$value": "{fg.muted}"
      },
      "focus-surface": {
        "$description": "计算焦点环对比度时使用的最终实体底，不让组件拿页面底代替。",
        "$type": "color",
        "$value": "{material.soft.bg}"
      }
    },
    "frosted": {
      "$description": "M2 轻透磨砂面，只给导航和锚定轻浮层。文字与图标使用独立不透明前景。",
      "compact": {
        "$description": "Tooltip 等紧凑反白提示面的光学尺度；surface 色仍由组件按 tone 现取。",
        "alpha": { "$description": "六种 tone 在纯黑、纯白、灰色与品牌底上的正文对比均不低于 4.5:1。", "$type": "number", "$value": "{alpha.ultra-high}" },
        "backdrop": { "$description": "紧凑文字面的短半径采样；高遮蔽 tint 已承担主要隔离，不使用标准 M2 的 16px。", "$type": "string", "$value": "blur({blur.sm}) saturate(104%)" },
        "shadow": { "$description": "小浮层的贴面与短距环境层；不含 inset 高光。", "$type": "shadow", "$value": "0 1px 2px -1px oklch(0.145 0.005 258 / 0.08), 0 6px 16px -8px oklch(0.145 0.005 258 / 0.12)" }
      },
      "bg": { "$type": "color", "$value": "oklch(0.99 0.003 258 / {alpha.high})" },
      "backdrop": { "$description": "固定半径与轻饱和，不在交互期间动画滤镜。", "$type": "string", "$value": "blur({blur.md}) saturate(108%)" },
      "border": { "$type": "color", "$value": "oklch(0.145 0.005 258 / 0.14)" },
      "highlight": { "$type": "color", "$value": "oklch(1 0 0 / 0.52)" },
      "shadow": { "$description": "锚定浮层的贴面层与环境层，不含 inset 高光。", "$type": "shadow", "$value": "0 2px 4px -2px oklch(0.145 0.005 258 / 0.1), 0 12px 28px -12px oklch(0.145 0.005 258 / 0.16)" },
      "separator": { "$type": "color", "$value": "oklch(0.145 0.005 258 / 0.12)" },
      "fg": { "$type": "color", "$value": "{fg.default}" },
      "fg-muted": { "$type": "color", "$value": "{fg.muted}" },
      "focus-surface": { "$description": "焦点环的实体隔离底；组件必须真正把它画在获焦控制上。", "$type": "color", "$value": "{bg.surface}" }
    }
  }
}
