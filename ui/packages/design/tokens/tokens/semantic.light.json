{
  "bg": {
    "page": {
      "$description": "页面底：面之下的那一层，铺满视口、不承载任何部件。比 {bg.surface} 暗一档，面才浮得出来。控件盒的底是 {bg.canvas}，两者取值不同。",
      "$type": "color",
      "$value": "{color.neutral.50}"
    },
    "canvas": {
      "$type": "color",
      "$value": "{color.neutral.0}"
    },
    "surface": {
      "$type": "color",
      "$value": "{color.neutral.0}"
    },
    "surface-raised": {
      "$type": "color",
      "$value": "{color.neutral.0}"
    },
    "subtle": {
      "$type": "color",
      "$value": "{color.neutral.100}"
    },
    "subtle-hover": {
      "$type": "color",
      "$value": "{color.neutral.200}"
    },
    "subtle-active": {
      "$type": "color",
      "$value": "{color.neutral.300}"
    },
    "muted": {
      "$type": "color",
      "$value": "{color.neutral.100}"
    },
    "brand": {
      "$type": "color",
      "$value": "{color.brand.600}"
    },
    "brand-hover": {
      "$type": "color",
      "$value": "{color.brand.700}"
    },
    "brand-active": {
      "$type": "color",
      "$value": "{color.brand.800}"
    },
    "brand-subtle": {
      "$description": "品牌淡底：选中与当前态的行面 / 段面。与 -hover（20%）、-active（28%）同一条曲线，也与语气层 --xh-_tone-subtle 的 12% 同式：写了 data-tone='brand' 与不写语气时兑出同一个颜色。兑的对象是 {bg.surface}：深色档 canvas 比 surface 还暗，兑 canvas 会让选中面陷进面里。",
      "$type": "color",
      "$value": "color-mix(in oklab, {bg.brand} 12%, {bg.surface})"
    },
    "brand-subtle-hover": {
      "$type": "color",
      "$value": "color-mix(in oklab, {bg.brand} 20%, {bg.surface})"
    },
    "brand-subtle-active": {
      "$type": "color",
      "$value": "color-mix(in oklab, {bg.brand} 28%, {bg.surface})"
    },
    "overlay": {
      "$type": "color",
      "$value": "oklch(0 0 0 / 0.45)"
    },
    "scrollbar-track": {
      "$type": "color",
      "$value": "oklch(0 0 0 / 0)"
    }
  },
  "fg": {
    "default": {
      "$type": "color",
      "$value": "{color.neutral.950}"
    },
    "muted": {
      "$type": "color",
      "$value": "{color.neutral.600}"
    },
    "subtle": {
      "$type": "color",
      "$value": "{color.neutral.550}"
    },
    "disabled": {
      "$type": "color",
      "$value": "{color.neutral.400}"
    },
    "on-brand": {
      "$type": "color",
      "$value": "{color.neutral.0}"
    },
    "on-brand-subtle": {
      "$description": "品牌淡底（{bg.brand-subtle} 及其 -hover / -active 三档）上的文字与字形。与语气层 --xh-_tone-fg 同式：往正文色兑到 60%，浅色态变深、深色态变浅。浅色实测压 12% / 20% / 28% 三档为 8.49 / 7.60 / 6.78；直接取 brand.700 在 28% 按下面只有 4.42，够不到 AA。",
      "$type": "color",
      "$value": "color-mix(in oklab, {bg.brand} 60%, {fg.default})"
    },
    "brand": {
      "$type": "color",
      "$value": "{color.brand.600}"
    },
    "brand-strong": {
      "$type": "color",
      "$value": "{color.brand.700}"
    },
    "success": {
      "$type": "color",
      "$value": "{color.success.700}"
    },
    "warning": {
      "$type": "color",
      "$value": "{color.warning.700}"
    },
    "info": {
      "$type": "color",
      "$value": "{color.info.700}"
    },
    "danger": {
      "$type": "color",
      "$value": "{color.danger.600}"
    },
    "danger-hover": {
      "$type": "color",
      "$value": "{color.danger.700}"
    },
    "scrollbar-thumb": {
      "$type": "color",
      "$value": "color-mix(in oklab, {fg.default} 15%, transparent)"
    },
    "scrollbar-thumb-hover": {
      "$type": "color",
      "$value": "color-mix(in oklab, {fg.default} 25%, transparent)"
    },
    "scrollbar-thumb-active": {
      "$type": "color",
      "$value": "color-mix(in oklab, {fg.default} 35%, transparent)"
    }
  },
  "border": {
    "default": {
      "$type": "color",
      "$value": "{color.neutral.200}"
    },
    "subtle": {
      "$type": "color",
      "$value": "{color.neutral.100}"
    },
    "strong": {
      "$type": "color",
      "$value": "{color.neutral.300}"
    },
    "control": {
      "$type": "color",
      "$value": "{color.neutral.450}"
    },
    "control-hover": {
      "$type": "color",
      "$value": "{color.neutral.500}"
    },
    "control-focus": {
      "$description": "聚焦时控件的描边色，与聚焦环同色；常态描边是 {border.control}，两者取值不同，聚焦才在描边上看得出来。",
      "$type": "color",
      "$value": "{ring.focus}"
    },
    "invalid": {
      "$type": "color",
      "$value": "{color.danger.600}"
    },
    "at-limit": {
      "$type": "color",
      "$value": "{color.warning.600}"
    }
  },
  "ring": {
    "focus": {
      "$description": "浅色面上的公共键盘焦点环。取 brand.600，确保压在 canvas、surface 与 neutral.200 高亮面上都达到 3:1 非文本对比。",
      "$type": "color",
      "$value": "{color.brand.600}"
    },
    "invalid": {
      "$type": "color",
      "$value": "{color.danger.500}"
    }
  },
  "gradient": {
    "brand": {
      "from": {
        "$description": "品牌渐变的起点。走向由用它的地方定，起点是对比度低的那一端。白底上实测 3.74:1，只够展示级字号。",
        "$type": "color",
        "$value": "{color.brand.500}"
      },
      "to": {
        "$description": "品牌渐变的终点，对比度高的那一端；白底上实测 6.48:1。两端跨 2 档色阶，明度差 0.135，渐变才看得出来。",
        "$type": "color",
        "$value": "{color.brand.700}"
      }
    }
  },
  "diff": {
    "added-bg": {
      "$type": "color",
      "$value": "oklch(0.94 0.05 150)"
    },
    "added-fg": {
      "$type": "color",
      "$value": "oklch(0.44 0.13 150)"
    },
    "removed-bg": {
      "$type": "color",
      "$value": "oklch(0.94 0.05 25)"
    },
    "removed-fg": {
      "$type": "color",
      "$value": "oklch(0.47 0.16 25)"
    }
  },
  "syntax": {
    "string": {
      "$type": "color",
      "$value": "oklch(0.52 0.13 165)"
    },
    "number": {
      "$type": "color",
      "$value": "oklch(0.5 0.13 70)"
    },
    "keyword": {
      "$type": "color",
      "$value": "oklch(0.5 0.2 300)"
    }
  }
}
