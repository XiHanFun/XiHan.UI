{
  "$description": "density 轴 · compact 档：只写与 comfortable 基线不同的覆盖项。收的是盒子（高度/内距/间隙），不动字号与字形，可读性不随密度掉。",
  "control": {
    "h-sm": { "$type": "dimension", "$value": "24px" },
    "h-md": { "$type": "dimension", "$value": "28px" },
    "h-lg": { "$type": "dimension", "$value": "36px" },
    "box-sm": { "$type": "dimension", "$value": "28px" },
    "box-md": { "$type": "dimension", "$value": "36px" },
    "box-lg": { "$type": "dimension", "$value": "44px" },
    "px-sm": { "$type": "dimension", "$value": "{space.1_5}" },
    "px-md": { "$type": "dimension", "$value": "{space.2}" },
    "px-lg": { "$type": "dimension", "$value": "{space.3}" },
    "gap-md": { "$type": "dimension", "$value": "{space.1_5}" },
    "gap-lg": { "$type": "dimension", "$value": "{space.2}" },
    "action-size": { "$type": "dimension", "$value": "20px" },
    "indicator-sm": { "$type": "dimension", "$value": "10px" },
    "indicator-md": { "$type": "dimension", "$value": "14px" },
    "indicator-lg": { "$type": "dimension", "$value": "18px" }
  },
  "switch": {
    "track-h-sm": { "$type": "dimension", "$value": "16px" },
    "track-h-md": { "$type": "dimension", "$value": "20px" },
    "track-h-lg": { "$type": "dimension", "$value": "24px" }
  },
  "field": {
    "py": { "$type": "dimension", "$value": "{space.1_5}" }
  },
  "list": {
    "item-py-sm": { "$type": "dimension", "$value": "{space.1_5}" },
    "item-py-md": { "$type": "dimension", "$value": "{space.2}" },
    "item-py-lg": { "$type": "dimension", "$value": "{space.3}" },
    "item-px-sm": { "$type": "dimension", "$value": "{space.2}" },
    "item-px-md": { "$type": "dimension", "$value": "{space.3}" },
    "item-px-lg": { "$type": "dimension", "$value": "{space.4}" },
    "option-py-sm": { "$type": "dimension", "$value": "{space.0_5}" },
    "option-py-md": { "$type": "dimension", "$value": "{space.1}" },
    "option-py-lg": { "$type": "dimension", "$value": "{space.1_5}" }
  },
  "table": {
    "cell-py-sm": { "$type": "dimension", "$value": "{space.0_5}" },
    "cell-py-md": { "$type": "dimension", "$value": "{space.1_5}" },
    "cell-py-lg": { "$type": "dimension", "$value": "{space.2}" }
  },
  "viewport": {
    "max-h": { "$type": "dimension", "$value": "20rem" },
    "h-sm": { "$type": "dimension", "$value": "10rem" },
    "h-md": { "$type": "dimension", "$value": "14rem" },
    "h-lg": { "$type": "dimension", "$value": "20rem" }
  },
  "overlay": {
    "menu-max-h": { "$type": "dimension", "$value": "17rem" },
    "max-h": { "$type": "dimension", "$value": "14rem" }
  },
  "surface": {
    "py-sm": { "$type": "dimension", "$value": "{space.2}" },
    "px-sm": { "$type": "dimension", "$value": "{space.3}" }
  },
  "section": {
    "py-sm": { "$type": "dimension", "$value": "{space.3}" },
    "py-md": { "$type": "dimension", "$value": "{space.4}" },
    "py-lg": { "$type": "dimension", "$value": "{space.6}" }
  },
  "stack": {
    "gap-sm": { "$type": "dimension", "$value": "{space.1_5}" },
    "gap-md": { "$type": "dimension", "$value": "{space.3}" },
    "gap-lg": { "$type": "dimension", "$value": "{space.5}" }
  },
  "layout": {
    "gap-sm": { "$type": "dimension", "$value": "{space.1_5}" },
    "gap-md": { "$type": "dimension", "$value": "{space.2_5}" },
    "gap-lg": { "$type": "dimension", "$value": "{space.3}" },
    "gap-xl": { "$type": "dimension", "$value": "{space.5}" }
  }
}
