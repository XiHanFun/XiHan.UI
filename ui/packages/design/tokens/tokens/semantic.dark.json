{
  "bg": {
    "page": { "$description": "页面底：面之下的那一层，铺满视口、不承载任何部件。深色档它是色阶最暗的一档，面与抬起的面依次往亮端走。", "$type": "color", "$value": "{color.neutral.950}" },
    "canvas": { "$type": "color", "$value": "{color.neutral.950}" },
    "surface": { "$type": "color", "$value": "{color.neutral.900}" },
    "surface-raised": { "$description": "抬起的面。深色档取半档 750，与淡底 {bg.subtle} 差一道明度：抬起的面上那些底色取淡底的部件（通知卡里的动作钮、日志面板上的滚动钮）静态时才有身形。", "$type": "color", "$value": "{color.neutral.750}" },
    "subtle": { "$type": "color", "$value": "{color.neutral.800}" },
    "subtle-hover": { "$type": "color", "$value": "{color.neutral.700}" },
    "subtle-active": { "$type": "color", "$value": "{color.neutral.600}" },
    "muted": { "$type": "color", "$value": "{color.neutral.800}" },
    "brand": { "$type": "color", "$value": "{color.brand.500}" },
    "brand-hover": { "$type": "color", "$value": "{color.brand.400}" },
    "brand-active": { "$type": "color", "$value": "{color.brand.300}" },
    "brand-subtle": { "$type": "color", "$value": "{color.brand.950}" },
    "overlay": { "$type": "color", "$value": "oklch(0 0 0 / 0.6)" },
    "scrollbar-track": { "$type": "color", "$value": "{color.neutral.900}" }
  },
  "fg": {
    "default": { "$type": "color", "$value": "{color.neutral.50}" },
    "muted": { "$type": "color", "$value": "{color.neutral.400}" },
    "subtle": { "$type": "color", "$value": "{color.neutral.450}" },
    "disabled": { "$type": "color", "$value": "{color.neutral.600}" },
    "on-brand": { "$type": "color", "$value": "{color.neutral.950}" },
    "brand": { "$type": "color", "$value": "{color.brand.400}" },
    "brand-strong": { "$type": "color", "$value": "{color.brand.300}" },
    "success": { "$type": "color", "$value": "{color.success.500}" },
    "warning": { "$type": "color", "$value": "{color.warning.500}" },
    "info": { "$type": "color", "$value": "{color.info.500}" },
    "danger": { "$type": "color", "$value": "{color.danger.500}" },
    "danger-hover": { "$type": "color", "$value": "{color.danger.400}" },
    "scrollbar-thumb": { "$type": "color", "$value": "{color.neutral.500}" },
    "scrollbar-thumb-hover": { "$type": "color", "$value": "{color.neutral.400}" },
    "scrollbar-thumb-active": { "$type": "color", "$value": "{color.neutral.300}" }
  },
  "border": {
    "default": { "$description": "装饰性边界。深色档留在 700：往下的半档 750 与 {bg.subtle} 只差 1.04，热力图格子的描边落到那一档就与空格的底连成一片。", "$type": "color", "$value": "{color.neutral.700}" },
    "subtle": { "$type": "color", "$value": "{color.neutral.800}" },
    "strong": { "$type": "color", "$value": "{color.neutral.600}" },
    "control": { "$type": "color", "$value": "{color.neutral.550}" },
    "control-hover": { "$type": "color", "$value": "{color.neutral.500}" },
    "control-focus": { "$description": "聚焦时控件的描边色，与聚焦环同色；常态描边是 {border.control}，两者取值不同，聚焦才在描边上看得出来。", "$type": "color", "$value": "{ring.focus}" },
    "invalid": { "$type": "color", "$value": "{color.danger.500}" },
    "at-limit": { "$type": "color", "$value": "{color.warning.500}" }
  },
  "ring": {
    "focus": { "$type": "color", "$value": "{color.brand.400}" },
    "invalid": { "$type": "color", "$value": "{color.danger.400}" }
  },
  "gradient": {
    "brand": {
      "from": { "$description": "深色档往色阶的亮端走，与浅色档取值不同：深底上实测 7.33:1。", "$type": "color", "$value": "{color.brand.400}" },
      "to": { "$description": "深底上实测 10.85:1，明度差 0.107，与浅色档的 0.135 同一量级。", "$type": "color", "$value": "{color.brand.300}" }
    }
  },
  "diff": {
    "added-bg": { "$type": "color", "$value": "oklch(0.3 0.05 150)" },
    "added-fg": { "$type": "color", "$value": "oklch(0.86 0.12 150)" },
    "removed-bg": { "$type": "color", "$value": "oklch(0.3 0.05 25)" },
    "removed-fg": { "$type": "color", "$value": "oklch(0.85 0.12 25)" }
  },
  "syntax": {
    "string": { "$type": "color", "$value": "oklch(0.85 0.12 165)" },
    "number": { "$type": "color", "$value": "oklch(0.85 0.12 75)" },
    "keyword": { "$type": "color", "$value": "oklch(0.82 0.14 300)" }
  },
  "elevation": {
    "$description": "深色档的投影色留在纯黑：中性色阶最暗的一档（0.145）比页面底还亮，拿它当投影压不出任何深度。四档都在末尾带一条 1px 的浅色描边把面的上沿提出来——raised 与 lifted 那条写成 inset 且只画上边缘，不绕四周：这两档落在自带 --xh-border-control 的输入框壳与自带 2px 描边的滑杆拇指上，绕一圈就与那条描边并成相距 1px 的两道线。",
    "raised": { "$type": "shadow", "$value": "0 1px 1px -0.5px oklch(0 0 0 / 0.4), 0 2px 3px -1.5px oklch(0 0 0 / 0.36), 0 3px 6px -3px oklch(0 0 0 / 0.3), inset 0 1px 0 0 oklch(1 0 0 / 0.05)" },
    "lifted": { "$description": "深色档同样落在两档中间：三层的偏移与模糊照浅色档的几何，主层不透明度 0.4→0.45→0.5。", "$type": "shadow", "$value": "0 1px 2px -0.5px oklch(0 0 0 / 0.45), 0 3px 6px -2px oklch(0 0 0 / 0.42), 0 6px 12px -5px oklch(0 0 0 / 0.36), inset 0 1px 0 0 oklch(1 0 0 / 0.06)" },
    "floating": { "$type": "shadow", "$value": "0 1px 2px -0.5px oklch(0 0 0 / 0.5), 0 4px 8px -2px oklch(0 0 0 / 0.45), 0 10px 20px -6px oklch(0 0 0 / 0.4), 0 0 0 1px oklch(1 0 0 / 0.06)" },
    "sheet": { "$type": "shadow", "$value": "0 1px 3px -0.5px oklch(0 0 0 / 0.6), 0 8px 16px -4px oklch(0 0 0 / 0.5), 0 20px 40px -12px oklch(0 0 0 / 0.45), 0 0 0 1px oklch(1 0 0 / 0.08)" }
  }
}
