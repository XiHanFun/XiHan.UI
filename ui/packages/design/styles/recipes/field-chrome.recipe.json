{
  "$description": "Field Chrome 家族配方：字段视觉盒、装饰段与原生输入共用一套尺寸、布局、状态和输入能力规则。组件只映射公开覆盖槽。",
  "version": 1,
  "sizes": ["sm", "md", "lg"],
  "layouts": ["single-line", "textarea", "multi-tag"],
  "states": ["rest", "hover", "focus", "invalid", "readOnly", "disabled", "loading"],
  "sizeValues": {
    "sm": {
      "controlHeight": "var(--xh-control-h-sm)",
      "paddingInline": "var(--xh-control-px-sm)",
      "gap": "var(--xh-control-gap-sm)",
      "fontSize": "var(--xh-control-font-sm)",
      "glyphSize": "var(--xh-glyph-size-sm)"
    },
    "md": {
      "controlHeight": "var(--xh-control-h-md)",
      "paddingInline": "var(--xh-control-px-md)",
      "gap": "var(--xh-control-gap-md)",
      "fontSize": "var(--xh-control-font-md)",
      "glyphSize": "var(--xh-glyph-size-md)"
    },
    "lg": {
      "controlHeight": "var(--xh-control-h-lg)",
      "paddingInline": "var(--xh-control-px-lg)",
      "gap": "var(--xh-control-gap-lg)",
      "fontSize": "var(--xh-control-font-lg)",
      "glyphSize": "var(--xh-glyph-size-lg)"
    }
  },
  "layoutValues": {
    "single-line": {
      "alignItems": "center",
      "blockSize": "var(--xh-field-control-height, var(--xh-_field-size-control-height))",
      "minBlockSize": "var(--xh-field-control-height, var(--xh-_field-size-control-height))",
      "paddingBlock": "0",
      "flexWrap": "nowrap"
    },
    "textarea": {
      "alignItems": "flex-start",
      "blockSize": "auto",
      "minBlockSize": "var(--xh-field-control-height, var(--xh-_field-size-control-height))",
      "paddingBlock": "0",
      "flexWrap": "nowrap"
    },
    "multi-tag": {
      "alignItems": "center",
      "blockSize": "auto",
      "minBlockSize": "var(--xh-field-control-height, var(--xh-_field-size-control-height))",
      "paddingBlock": "var(--xh-space-1)",
      "flexWrap": "wrap"
    }
  },
  "stateValues": {
    "rest": {
      "backgroundColor": "var(--xh-bg-canvas)",
      "color": "var(--xh-fg-default)",
      "borderColor": "transparent",
      "shadow": "var(--xh-elevation-raised)",
      "cursor": "text"
    },
    "hover": {
      "backgroundColor": "color-mix(in oklab, var(--xh-bg-subtle) 45%, var(--xh-bg-canvas))",
      "color": "var(--xh-fg-default)",
      "borderColor": "var(--xh-border-default)",
      "shadow": "var(--xh-elevation-raised)",
      "cursor": "text"
    },
    "focus": {
      "backgroundColor": "var(--xh-bg-canvas)",
      "color": "var(--xh-fg-default)",
      "borderColor": "var(--xh-border-control-focus)",
      "shadow": "var(--xh-elevation-raised)",
      "cursor": "text",
      "ringColor": "var(--xh-ring-focus)"
    },
    "invalid": {
      "backgroundColor": "var(--xh-bg-canvas)",
      "color": "var(--xh-fg-default)",
      "borderColor": "var(--xh-border-invalid)",
      "shadow": "var(--xh-elevation-raised)",
      "cursor": "text",
      "ringColor": "var(--xh-ring-invalid)"
    },
    "readOnly": {
      "backgroundColor": "var(--xh-bg-subtle)",
      "color": "var(--xh-fg-default)",
      "borderColor": "transparent",
      "shadow": "none",
      "cursor": "default"
    },
    "disabled": {
      "backgroundColor": "var(--xh-bg-subtle)",
      "color": "var(--xh-fg-disabled)",
      "borderColor": "transparent",
      "shadow": "none",
      "cursor": "not-allowed"
    },
    "loading": {
      "backgroundColor": "var(--xh-bg-canvas)",
      "color": "var(--xh-fg-muted)",
      "borderColor": "transparent",
      "shadow": "var(--xh-elevation-raised)",
      "cursor": "progress"
    }
  },
  "nativeInput": {
    "placeholderColor": "var(--xh-fg-subtle)",
    "autofillBackground": "var(--xh-bg-canvas)",
    "autofillForeground": "var(--xh-fg-default)",
    "textareaPaddingBlock": "var(--xh-space-2)",
    "ime": "preserve-native-composition"
  },
  "motion": {
    "duration": "var(--xh-motion-duration-micro)",
    "easing": "var(--xh-motion-ease-enter)"
  },
  "compact": {
    "strategy": "semantic-token-remap",
    "tokens": [
      "--xh-control-h-sm",
      "--xh-control-h-md",
      "--xh-control-h-lg",
      "--xh-control-px-sm",
      "--xh-control-px-md",
      "--xh-control-px-lg",
      "--xh-control-gap-sm",
      "--xh-control-gap-md",
      "--xh-control-gap-lg"
    ]
  },
  "direction": {
    "axis": "logical",
    "flow": "row"
  },
  "forcedColors": {
    "rest": { "backgroundColor": "Canvas", "color": "CanvasText", "borderColor": "ButtonText", "outlineColor": "Highlight" },
    "hover": { "backgroundColor": "Canvas", "color": "CanvasText", "borderColor": "Highlight", "outlineColor": "Highlight" },
    "focus": { "backgroundColor": "Canvas", "color": "CanvasText", "borderColor": "Highlight", "outlineColor": "Highlight" },
    "invalid": { "backgroundColor": "Canvas", "color": "CanvasText", "borderColor": "Highlight", "outlineColor": "Highlight" },
    "readOnly": { "backgroundColor": "Canvas", "color": "CanvasText", "borderColor": "GrayText", "outlineColor": "Highlight" },
    "disabled": { "backgroundColor": "Canvas", "color": "GrayText", "borderColor": "GrayText", "outlineColor": "GrayText" },
    "loading": { "backgroundColor": "Canvas", "color": "CanvasText", "borderColor": "ButtonText", "outlineColor": "Highlight" }
  }
}
