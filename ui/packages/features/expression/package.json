{
  "name": "@xihan-ui/expression",
  "type": "module",
  "version": "4.2.0",
  "description": "XiHan.UI restricted expression language — parse to a serializable AST, check statically, evaluate deterministically with exact decimals, no eval.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://ui.docs.xihanfun.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.UI.git",
    "directory": "ui/packages/features/expression"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.UI/issues"
  },
  "keywords": [
    "expression",
    "formula",
    "parser",
    "evaluator",
    "decimal",
    "low-code"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "vitest": "catalog:"
  }
}
