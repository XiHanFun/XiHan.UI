{
  "name": "@xihan-ui/designer-shell",
  "type": "module",
  "version": "5.0.0",
  "description": "XiHan.UI designer shell — Web Components parts shared by visual designers: property panel, rulers and guides, transform overlay, palette drag and drop, page structure, history, issue list, minimap, frame, settings dialog, field import dialog, JSON editor and guided tour.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://ui.docs.xihanfun.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.UI.git",
    "directory": "ui/packages/features/designer-shell"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.UI/issues"
  },
  "keywords": [
    "designer",
    "web-components",
    "property-panel",
    "ruler",
    "drag-and-drop"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./language": {
      "types": "./dist/language.d.ts",
      "import": "./dist/language.js"
    },
    "./style.css": "./style.css",
    "./style.unlayered.css": "./dist/style.unlayered.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist",
    "style.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown && node build/emit-unlayered-style.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@xihan-ui/core": "workspace:^",
    "@xihan-ui/designer-kit": "workspace:^",
    "@xihan-ui/pointer": "workspace:^",
    "@xihan-ui/tokens": "workspace:^",
    "@xihan-ui/viz": "workspace:^",
    "@xihan-ui/web-components": "workspace:^"
  },
  "devDependencies": {
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/styles": "workspace:*",
    "@xihan-ui/testing": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "vitest": "catalog:"
  }
}
