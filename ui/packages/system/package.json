{
  "name": "@xihan-ui/system",
  "type": "module",
  "version": "0.0.0",
  "description": "XiHan.UI design tokens + theme runtime.",
  "license": "MIT",
  "sideEffects": ["./tokens.css"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "tokens.css", "tokens.json"],
  "scripts": {
    "gen": "node build/emit-tokens.mjs",
    "build": "node build/emit-tokens.mjs && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "jsdom": "catalog:",
    "vitest": "catalog:"
  }
}
