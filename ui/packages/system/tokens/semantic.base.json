{
  "control": {
    "h-sm": { "$type": "dimension", "$value": "28px" },
    "h-md": { "$type": "dimension", "$value": "32px" },
    "h-lg": { "$type": "dimension", "$value": "40px" },
    "px-sm": { "$type": "dimension", "$value": "{space.2}" },
    "px-md": { "$type": "dimension", "$value": "{space.3}" },
    "px-lg": { "$type": "dimension", "$value": "{space.4}" },
    "gap-sm": { "$type": "dimension", "$value": "{space.1}" },
    "gap-md": { "$type": "dimension", "$value": "{space.2}" },
    "gap-lg": { "$type": "dimension", "$value": "{space.2}" }
  },
  "field": {
    "py": { "$type": "dimension", "$value": "{space.2}" }
  },
  "shape": {
    "control": { "$type": "dimension", "$value": "{radius.md}" },
    "surface": { "$type": "dimension", "$value": "{radius.lg}" },
    "pill": { "$type": "dimension", "$value": "{radius.full}" }
  },
  "ring": {
    "width": { "$type": "dimension", "$value": "{stroke.thick}" },
    "offset": { "$type": "dimension", "$value": "{stroke.thin}" }
  },
  "elevation": {
    "0": { "$type": "shadow", "$value": "none" },
    "1": { "$type": "shadow", "$value": "{shadow.sm}" },
    "2": { "$type": "shadow", "$value": "{shadow.md}" },
    "3": { "$type": "shadow", "$value": "{shadow.lg}" },
    "4": { "$type": "shadow", "$value": "{shadow.xl}" }
  },
  "motion": {
    "duration-enter": { "$type": "duration", "$value": "{duration.normal}" },
    "duration-exit": { "$type": "duration", "$value": "{duration.fast}" },
    "duration-micro": { "$type": "duration", "$value": "{duration.fast}" },
    "ease-enter": { "$type": "cubicBezier", "$value": "{ease.out}" },
    "ease-exit": { "$type": "cubicBezier", "$value": "{ease.in}" }
  },
  "layer": {
    "drawer": { "$type": "number", "$value": "{z.drawer}" },
    "modal": { "$type": "number", "$value": "{z.modal}" },
    "popover": { "$type": "number", "$value": "{z.popover}" },
    "toast": { "$type": "number", "$value": "{z.toast}" },
    "tooltip": { "$type": "number", "$value": "{z.tooltip}" }
  },
  "section": {
    "py": { "$type": "dimension", "$value": "{space.5}" }
  },
  "stack": {
    "gap-md": { "$type": "dimension", "$value": "{space.4}" }
  },
  "text": {
    "label-size": { "$type": "dimension", "$value": "{font-size.md}" },
    "label-weight": { "$type": "number", "$value": "{font-weight.medium}" },
    "body-size": { "$type": "dimension", "$value": "{font-size.md}" },
    "body-leading": { "$type": "number", "$value": "{leading.normal}" },
    "body-weight": { "$type": "number", "$value": "{font-weight.regular}" },
    "heading-3-size": { "$type": "dimension", "$value": "{font-size.xl}" },
    "heading-3-weight": { "$type": "number", "$value": "{font-weight.semibold}" }
  }
}
