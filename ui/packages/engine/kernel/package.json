{
  "name": "@xihan-ui/kernel",
  "type": "module",
  "version": "1.0.0-alpha.2",
  "description": "XiHan.UI Foundation primitives — framework-agnostic, zero runtime dependencies.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://ui.docs.xihanfun.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.UI.git",
    "directory": "ui/packages/engine/kernel"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.UI/issues"
  },
  "keywords": [
    "design-system",
    "headless-ui",
    "framework-agnostic",
    "anatomy",
    "data-part"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./anatomy": {
      "types": "./dist/anatomy.d.ts",
      "import": "./dist/anatomy.js"
    },
    "./attrs": {
      "types": "./dist/attrs.d.ts",
      "import": "./dist/attrs.js"
    },
    "./compose": {
      "types": "./dist/compose.d.ts",
      "import": "./dist/compose.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./deprecations": {
      "types": "./dist/deprecations.d.ts",
      "import": "./dist/deprecations.js"
    },
    "./guards": {
      "types": "./dist/guards.d.ts",
      "import": "./dist/guards.js"
    },
    "./id-generator": {
      "types": "./dist/id-generator.d.ts",
      "import": "./dist/id-generator.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./merge-props": {
      "types": "./dist/merge-props.d.ts",
      "import": "./dist/merge-props.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    },
    "./normalize-props": {
      "types": "./dist/normalize-props.d.ts",
      "import": "./dist/normalize-props.js"
    },
    "./runtime-config": {
      "types": "./dist/runtime-config.d.ts",
      "import": "./dist/runtime-config.js"
    },
    "./scope": {
      "types": "./dist/scope.d.ts",
      "import": "./dist/scope.js"
    },
    "./skin-check": {
      "types": "./dist/skin-check.d.ts",
      "import": "./dist/skin-check.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@xihan-ui/motion": "workspace:^"
  },
  "devDependencies": {
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "vitest": "catalog:"
  }
}
