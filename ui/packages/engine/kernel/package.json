{
  "name": "@xihan-ui/kernel",
  "type": "module",
  "version": "1.0.0-alpha.1",
  "description": "XiHan.UI Foundation primitives — framework-agnostic, zero runtime dependencies.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://ui.docs.xihanfun.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.UI.git",
    "directory": "ui/packages/engine/kernel"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.UI/issues"
  },
  "keywords": [
    "design-system",
    "headless-ui",
    "framework-agnostic",
    "anatomy",
    "data-part"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./skin-check": {
      "types": "./dist/skin-check.d.ts",
      "import": "./dist/skin-check.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "vitest": "catalog:"
  }
}
