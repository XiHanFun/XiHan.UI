{
  "name": "@xihan-ui/viz",
  "type": "module",
  "version": "2.1.0",
  "description": "XiHan.UI visualization engine — scales, ticks, shapes, axis layout, picking and sampling as pure functions, no third-party runtime dependency.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://ui.docs.xihanfun.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.UI.git",
    "directory": "ui/packages/engine/viz"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.UI/issues"
  },
  "keywords": [
    "visualization",
    "chart",
    "scale",
    "svg",
    "headless-ui"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "dependencies": {},
  "devDependencies": {
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "vitest": "catalog:"
  }
}
