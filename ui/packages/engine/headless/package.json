{
  "name": "@xihan-ui/headless",
  "type": "module",
  "version": "1.1.0",
  "description": "XiHan.UI headless components — anatomy, machine, connect. No styles.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://ui.docs.xihanfun.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.UI.git",
    "directory": "ui/packages/engine/headless"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.UI/issues"
  },
  "keywords": [
    "headless-ui",
    "unstyled",
    "accessible",
    "components",
    "aria"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@internationalized/date": "catalog:",
    "@xihan-ui/behavior": "workspace:^",
    "@xihan-ui/kernel": "workspace:^",
    "@xihan-ui/machine": "workspace:^",
    "@xihan-ui/motion": "workspace:^",
    "@xihan-ui/pointer": "workspace:^"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "jsdom": "catalog:",
    "vitest": "catalog:"
  }
}
