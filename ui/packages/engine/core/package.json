{
  "name": "@xihan-ui/core",
  "type": "module",
  "version": "4.2.0",
  "description": "XiHan.UI core runtime — anatomy and structure primitives, thin FSM, interaction behaviors. Framework-agnostic.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://ui.docs.xihanfun.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.UI.git",
    "directory": "ui/packages/engine/core"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.UI/issues"
  },
  "keywords": [
    "design-system",
    "headless-ui",
    "framework-agnostic",
    "anatomy",
    "state-machine",
    "focus-trap",
    "dismissable-layer",
    "accessibility"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./date": {
      "types": "./dist/date.d.ts",
      "import": "./dist/date.js"
    },
    "./hotkey": {
      "types": "./dist/hotkey.d.ts",
      "import": "./dist/hotkey.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    },
    "./presence": {
      "types": "./dist/presence.d.ts",
      "import": "./dist/presence.js"
    },
    "./rich-text": {
      "types": "./dist/rich-text.d.ts",
      "import": "./dist/rich-text.js"
    },
    "./rich-text-dom": {
      "types": "./dist/rich-text-dom.d.ts",
      "import": "./dist/rich-text-dom.js"
    },
    "./skin-check": {
      "types": "./dist/skin-check.d.ts",
      "import": "./dist/skin-check.js"
    },
    "./svg-export": {
      "types": "./dist/svg-export.d.ts",
      "import": "./dist/svg-export.js"
    },
    "./template": {
      "types": "./dist/template.d.ts",
      "import": "./dist/template.js"
    },
    "./url": {
      "types": "./dist/url.d.ts",
      "import": "./dist/url.js"
    },
    "./vanilla": {
      "types": "./dist/vanilla.d.ts",
      "import": "./dist/vanilla.js"
    },
    "./visual-environment": {
      "types": "./dist/visual-environment.d.ts",
      "import": "./dist/visual-environment.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run && node tests/production/run-machine-implementation-contract.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@xihan-ui/motion": "workspace:^"
  },
  "devDependencies": {
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "vitest": "catalog:"
  }
}
