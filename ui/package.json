{
  "name": "xihan-ui-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "lint": "oxlint . && eslint . && stylelint \"packages/**/*.css\"",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{json,css,scss,md,yaml,yml}\"",
    "size": "turbo run build && size-limit",
    "boundaries": "depcruise packages tooling apps",
    "gate": "node tooling/scripts/check-runtime-deps.mjs && node tooling/scripts/check-exact-pins.mjs && node tooling/scripts/check-tokens-dist.mjs",
    "gate:tokens": "pnpm --filter @xihan-ui/system gen && git diff --exit-code packages/system",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "clean:build": "node scripts/clean-dist.mjs",
    "clean:modules": "node scripts/clean-modules.mjs",
    "clean:lock": "node scripts/clean-lock.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@size-limit/preset-small-lib": "catalog:",
    "@types/node": "catalog:",
    "@xihan-ui/eslint-config": "workspace:*",
    "@xihan-ui/stylelint-config": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "simple-git-hooks": "catalog:",
    "size-limit": "catalog:",
    "stylelint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vue-tsc": "catalog:"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no -- commitlint --edit $1"
  }
}
