{
  "$comment": "分层依赖拓扑单一事实源。被 .dependency-cruiser.cjs 消费。键必须与 packages/ 下的目录一一对应，多一个少一个都会被门禁抛错。层级越低越基础，只能向下依赖。",
  "layers": {
    "core": { "level": 1, "canDependOn": [] },
    "machine": { "level": 1, "canDependOn": ["core"] },
    "system": { "level": 1, "canDependOn": [] },
    "behavior": { "level": 2, "canDependOn": ["core", "machine"] },
    "position": { "level": 2, "canDependOn": ["core"] },
    "highlight": { "level": 2, "canDependOn": ["core"] },
    "headless": { "level": 3, "canDependOn": ["core", "machine", "behavior", "system"] },
    "styled": { "level": 3, "canDependOn": [] },
    "visual": { "level": 3, "canDependOn": ["core", "behavior"] },
    "vue": { "level": 4, "canDependOn": ["core", "machine", "behavior", "headless", "position", "highlight", "system", "visual"] },
    "wc": { "level": 4, "canDependOn": ["core", "machine", "behavior", "headless", "position", "highlight", "system", "visual"] },
    "ai": { "level": 2, "canDependOn": ["core"] },
    "markdown": { "level": 2, "canDependOn": ["core"] },
    "icons": { "level": 1, "canDependOn": [] }
  }
}
