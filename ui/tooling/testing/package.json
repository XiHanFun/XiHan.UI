{
  "name": "@xihan-ui/testing",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "XiHan.UI cross-adapter conformance harness — spec-driven DOM snapshot, declarative steps, keyboard coverage. Not published.",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./a11y": {
      "types": "./dist/a11y.d.ts",
      "import": "./dist/a11y.js"
    },
    "./position": {
      "types": "./dist/position.d.ts",
      "import": "./dist/position.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@xihan-ui/headless": "workspace:*",
    "@xihan-ui/kernel": "workspace:*",
    "axe-core": "catalog:"
  },
  "devDependencies": {
    "@xihan-ui/build": "workspace:*",
    "@xihan-ui/tsconfig": "workspace:*",
    "jsdom": "catalog:",
    "vitest": "catalog:"
  }
}
